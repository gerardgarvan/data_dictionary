/* ============================================================
   SECTION 8 -- Comprehensive post-import assert: all 20 pdd.src_s*
   Checks: exists, nobs > 0, matches pdd.source_inventory row count.
   s18: expected inventory - 2 (dup exclusion).
   s19: expected <= inventory (blank-row drop PDD-D-08).
   ============================================================ */

%macro _assert_all_src;
  %local _ifc _fc _n_fail _nobs _inv _all;
  %let _n_fail = 0;
  %let _all = s01 s02 s03 s04 s05 s06 s07 s08 s09 s10
              s11 s12 s13 s14 s15 s16 s17 s18 s19 s20;

  %do _ifc = 1 %to 20;
    %let _fc = %scan(&_all, &_ifc, %str( ));
    %if not %sysfunc(exist(pdd.src_&_fc)) %then %do;
      %put ERROR: [03_import] pdd.src_&_fc MISSING;
      %let _n_fail = %eval(&_n_fail + 1);
    %end;
    %else %do;
      %let _nobs = -1;
      %let _inv  = -1;
      proc sql noprint;
        select count(*) into :_nobs trimmed from pdd.src_&_fc;
        select coalesce(row_count, -1) into :_inv trimmed
        from pdd.source_inventory where s_code = "&_fc";
      quit;
      %if &_nobs = -1 %then %do;
        %put ERROR: [03_import] pdd.src_&_fc nobs not populated;
        %let _n_fail = %eval(&_n_fail + 1);
      %end;
      %else %if &_nobs = 0 %then %do;
        %put ERROR: [03_import] pdd.src_&_fc has 0 rows;
        %let _n_fail = %eval(&_n_fail + 1);
      %end;
      %else %if "&_fc" = "s18" %then %do;
        %if &_inv = -1 %then
          %put NOTE: [03_import] pdd.src_s18 = &_nobs rows (no inventory -- cannot compare);
        %else %if &_nobs ne %eval(&_inv - 2) %then %do;
          %put ERROR: [03_import] pdd.src_s18 = &_nobs, expected inventory-2 = %eval(&_inv-2) -- MISMATCH;
          %let _n_fail = %eval(&_n_fail + 1);
        %end;
        %else %put NOTE: [03_import] pdd.src_s18 = &_nobs rows (inventory-2 = %eval(&_inv-2) -- OK);
      %end;
      %else %if "&_fc" = "s19" %then %do;
        %if &_inv = -1 %then
          %put NOTE: [03_import] pdd.src_s19 = &_nobs rows (no inventory -- cannot compare);
        %else %if &_nobs > &_inv %then %do;
          %put ERROR: [03_import] pdd.src_s19 = &_nobs exceeds inventory &_inv -- MISMATCH;
          %let _n_fail = %eval(&_n_fail + 1);
        %end;
        %else %put NOTE: [03_import] pdd.src_s19 = &_nobs rows (<= inventory &_inv, blank-drop PDD-D-08 -- OK);
      %end;
      %else %do;
        %if &_inv = -1 %then
          %put NOTE: [03_import] pdd.src_&_fc = &_nobs rows (no inventory -- cannot compare);
        %else %if &_nobs ne &_inv %then %do;
          %put ERROR: [03_import] pdd.src_&_fc = &_nobs rows, inventory = &_inv -- MISMATCH;
          %let _n_fail = %eval(&_n_fail + 1);
        %end;
        %else %put NOTE: [03_import] pdd.src_&_fc = &_nobs rows (matches inventory -- OK);
      %end;
    %end;
  %end;
  %if &_n_fail > 0 %then
    %fail_out(msg=%str(&_n_fail of 20 post-import assertion(s) failed -- see ERRORs above));
  %put NOTE: [03_import] all 20 pdd.src_s* post-import assertions passed;
%mend _assert_all_src;
%_assert_all_src;


/* ============================================================
   SECTION 9 -- s06 column-group profile
   pdd.qc_s06_groups + qc\s06_column_groups.xlsx
   ============================================================ */

/* Build the column-group table from pdd.header_inventory where s_code='s06'
   plus non-null % from pdd.src_s06. */

/* Step 9a: get s06 column inventory with inferred type from header_inventory */
proc sql;
  create table work._s06_cols as
  select col_name, col_type, col_len
  from pdd.header_inventory
  where s_code = 's06'
  order by col_name;
quit;

/* Step 9b: compute % non-null per column from pdd.src_s06
   For large column counts (3987) use dictionary.columns + a summary approach.
   We compute n non-missing via PROC MEANS ALL variables then join. */

/* Get total row count of pdd.src_s06 */
proc sql noprint;
  select count(*) into :_ns06 trimmed from pdd.src_s06;
quit;
%put NOTE: [03_import] pdd.src_s06 row count = &_ns06;

/* Compute nmiss per column via a single DATA step (handles char + numeric,
   avoids PROC MEANS which skips character cols and truncates long names).
   Temporary count arrays sized 4500 (covers s06 ~3987 cols). */
data work._s06_nmiss_long(keep=col_name nmiss pct_nonnull);
  set pdd.src_s06 end=_eof;
  array _n _numeric_;
  array _c _character_;
  length col_name $256 nmiss 8 pct_nonnull 8;
  array _ncnt_n {4500} _temporary_ (4500*0);   /* nmiss counts for numeric cols */
  array _ncnt_c {4500} _temporary_ (4500*0);   /* nmiss counts for char cols */
  retain _nrows 0;
  _nrows + 1;

  do _k = 1 to dim(_n);
    if missing(_n{_k}) then _ncnt_n{_k} = _ncnt_n{_k} + 1;
  end;
  do _k = 1 to dim(_c);
    if missing(_c{_k}) then _ncnt_c{_k} = _ncnt_c{_k} + 1;
  end;

  if _eof then do;
    do _k = 1 to dim(_n);
      col_name    = vname(_n{_k});
      nmiss       = _ncnt_n{_k};
      pct_nonnull = round(100 * (1 - nmiss / max(1, _nrows)), 0.1);
      output;
    end;
    do _k = 1 to dim(_c);
      col_name    = vname(_c{_k});
      nmiss       = _ncnt_c{_k};
      pct_nonnull = round(100 * (1 - nmiss / max(1, _nrows)), 0.1);
      output;
    end;
  end;
  drop _k;
run;

/* Assert rows output = column count in dictionary.columns for PDD.SRC_S06 */
%macro _assert_s06_nmiss_rows;
  %local _nmiss_rows _dict_cols;
  proc sql noprint;
    select count(*) into :_nmiss_rows trimmed from work._s06_nmiss_long;
    select count(*) into :_dict_cols  trimmed
    from dictionary.columns
    where upcase(libname) = 'PDD' and upcase(memname) = 'SRC_S06';
  quit;
  %if &_nmiss_rows ne &_dict_cols %then
    %fail_out(msg=%str(s06 nmiss DATA step output &_nmiss_rows rows but dictionary.columns shows &_dict_cols cols -- mismatch));
  %put NOTE: [03_import] s06 nmiss step: &_nmiss_rows rows output matches dictionary.columns (&_dict_cols cols) -- OK;
%mend _assert_s06_nmiss_rows;
%_assert_s06_nmiss_rows;

/* Step 9c: assign group prefix heuristic (Pattern 6).
   prefix = chars before first '_' or first digit run; min 3 / max 20 chars.
   Cols with no shared prefix (or prefix < 3 chars) -> '_SINGLETON_'. */
data work._s06_cols2;
  set work._s06_cols;
  length group_prefix $20;

  _pos_us = index(col_name, '_');
  _pos_dg = prxmatch('/\d/', col_name);

  /* Find first delimiter: underscore or digit run, min 3 chars */
  if _pos_us >= 3 and (_pos_dg = 0 or _pos_us <= _pos_dg) then
    group_prefix = upcase(substr(col_name, 1, min(20, _pos_us - 1)));
  else if _pos_dg >= 3 and (_pos_us = 0 or _pos_dg < _pos_us) then
    group_prefix = upcase(substr(col_name, 1, min(20, _pos_dg - 1)));
  else if length(col_name) >= 3 then
    group_prefix = upcase(substr(col_name, 1, min(20, length(col_name))));
  else
    group_prefix = '_SINGLETON_';

  if length(strip(group_prefix)) < 3 then group_prefix = '_SINGLETON_';
  drop _pos_us _pos_dg;
run;

/* Step 9d: join non-null % */
proc sql;
  create table work._s06_cols3 as
  select c.col_name, c.col_type, c.group_prefix,
         coalesce(n.pct_nonnull, 0) as pct_nonnull
  from work._s06_cols2 c
  left join work._s06_nmiss_long n on upcase(c.col_name) = upcase(n.col_name);
quit;

/* Step 9e: compute overlap with s03/s07 columns */
proc sql;
  create table work._s03s07_cols as
  select distinct upcase(col_name) as col_name_up length=200
  from pdd.header_inventory
  where s_code in ('s03', 's07');
quit;

/* Step 9f: build pdd.qc_s06_groups -- one row per group */
proc sql;
  create table work._s06_grp_base as
  select c.group_prefix as group length=20,
         count(*) as col_count,
         /* Modal col_type */
         case when sum(case when c.col_type='char' then 1 else 0 end) > 0
                and sum(case when c.col_type='num'  then 1 else 0 end) > 0
              then 'mixed'
              when sum(case when c.col_type='char' then 1 else 0 end) > 0
              then 'char'
              else 'num'
         end as inferred_type length=5,
         median(c.pct_nonnull) as median_pct_nonnull,
         sum(case when upcase(c.col_name) in (select col_name_up from work._s03s07_cols)
                  then 1 else 0 end) as overlap_s03_s07
  from work._s06_cols3 c
  group by c.group_prefix
  order by col_count desc;
quit;

/* Build example_cols: first 3 col_names alphabetically per group */
proc sort data=work._s06_cols3; by group_prefix col_name; run;

data work._s06_examples;
  set work._s06_cols3;
  by group_prefix;
  length _examples $200;
  retain _eg_cnt 0 _examples '';
  if first.group_prefix then do;
    _eg_cnt = 0;
    _examples = '';
  end;
  _eg_cnt + 1;
  if _eg_cnt <= 3 then do;
    if _examples = '' then _examples = strip(col_name);
    else _examples = catx(', ', _examples, strip(col_name));
  end;
  if last.group_prefix then do;
    group = group_prefix;
    example_cols = _examples;
    output;
  end;
  keep group example_cols;
run;

proc sql;
  create table pdd.qc_s06_groups as
  select g.group, e.example_cols length=200, g.col_count, g.inferred_type,
         round(g.median_pct_nonnull, 0.1) as median_pct_nonnull,
         g.overlap_s03_s07
  from work._s06_grp_base g
  left join work._s06_examples e on g.group = e.group
  order by g.col_count desc;
quit;

%_note_written_ds(ds=pdd.qc_s06_groups, label=pdd.qc_s06_groups);

/* Assert sum(col_count) = s06 total column count */
%macro _assert_s06_groups;
  %local _sum_cols _tot_cols;
  %let _sum_cols = -1;
  %let _tot_cols = -1;
  proc sql noprint;
    select sum(col_count) into :_sum_cols trimmed from pdd.qc_s06_groups;
    select count(*) into :_tot_cols trimmed
    from pdd.header_inventory
    where s_code = 's06';
  quit;
  %if &_sum_cols = -1 or &_tot_cols = -1 %then
    %fail_out(msg=%str(_assert_s06_groups counts not populated));
  %put NOTE: [03_import] s06 group profile: sum(col_count)=&_sum_cols total_cols_in_inventory=&_tot_cols;
  %if &_sum_cols = &_tot_cols %then
    %put NOTE: [03_import] s06 group col_count sum matches inventory total -- OK;
  %else
    %put WARNING: [03_import] s06 group col_count sum=&_sum_cols ne inventory total=&_tot_cols -- review;
%mend _assert_s06_groups;
%_assert_s06_groups;

/* Clean up work datasets */
proc datasets lib=work nolist nowarn;
  delete _s06_cols _s06_cols2 _s06_cols3 _s06_nmiss _s06_nmiss_long
         _s06_grp_base _s06_examples _s03s07_cols;
quit;


/* ============================================================
   SECTION 10 -- Write qc\s06_column_groups.xlsx (ODS Excel)
   UF colors (#0021A5, #FA4616); KEY sheet leftmost (PDD-D-09).
