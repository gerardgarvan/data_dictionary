/* ============================================================
   SECTION 4 -- Spec load + override merge
   ============================================================ */

/* Read import_spec_generated.csv into work.spec_gen
   Column src_encoding (D-23) read from 11th field: 'utf-8' or 'wlatin1'. */
options errors=1;
data work.spec_gen;
  length file_code $4 col_order 8 src_name $256 orig_col_name $256
         sas_name $32 sas_type $1 length_ 8 informat $16 format $16 notes $200
         src_encoding $10;
  infile "C:\data_dictionary\docs\import_spec_generated.csv"
         encoding='utf-8' dsd dlm=',' missover firstobs=2 lrecl=32767;
  input file_code $ col_order src_name $ orig_col_name $ sas_name $
        sas_type $ length_ informat $ format $ notes $ src_encoding $;
  /* Strip all character fields to remove CSV padding */
  file_code     = strip(file_code);
  src_name      = strip(src_name);
  orig_col_name = strip(orig_col_name);
  sas_name      = strip(sas_name);
  sas_type      = strip(sas_type);
  informat      = strip(informat);
  format        = strip(format);
  notes         = strip(notes);
  src_encoding  = strip(src_encoding);
  /* D-23: no silent fallback -- blank src_encoding means spec was not regenerated.
     Guard below fires %fail_out if any blank is found. */
  /* Rename length_ -> length after read (length is a reserved word in step
     context but fine as a variable name after assignment) */
  rename length_ = spec_length;
run;
options errors=20;

%put NOTE: [03_import] work.spec_gen loaded;

/* D-23 guard: src_encoding must be non-blank and in ('utf-8','wlatin1') for every row.
   A blank means 03a_build_spec.sas was not re-run after the D-23 fix. */
%macro _assert_spec_encoding;
  %local _n_blank_enc _n_bad_enc _n_wlatin_enc;
  %let _n_blank_enc  = -1;
  %let _n_bad_enc    = -1;
  %let _n_wlatin_enc = -1;
  proc sql noprint;
    select count(*) into :_n_blank_enc trimmed
    from work.spec_gen
    where missing(src_encoding) or strip(src_encoding) = '';
    select count(*) into :_n_bad_enc trimmed
    from work.spec_gen
    where strip(src_encoding) not in ('utf-8', 'wlatin1');
    select count(distinct file_code) into :_n_wlatin_enc trimmed
    from work.spec_gen
    where strip(src_encoding) = 'wlatin1';
  quit;
  %if &_n_blank_enc > 0 %then
    %fail_out(msg=%str(D-23: &_n_blank_enc rows in work.spec_gen have blank src_encoding -- rerun 03a_build_spec.sas));
  %if &_n_bad_enc > 0 %then
    %fail_out(msg=%str(D-23: &_n_bad_enc rows in work.spec_gen have invalid src_encoding (not utf-8 or wlatin1)));
  %if &_n_wlatin_enc ne 7 %then
    %fail_out(msg=%str(D-23: expected 7 wlatin1 file_codes in work.spec_gen but found &_n_wlatin_enc -- rerun 03a_build_spec.sas));
  %put NOTE: [03_import] D-23 encoding guard passed: 7 wlatin1 file_codes confirmed;
%mend _assert_spec_encoding;
%_assert_spec_encoding;

/* If import_spec_overrides.csv exists, read and merge (override wins) */
%macro _apply_overrides;
  %local _ovr_path;
  %let _ovr_path = C:\data_dictionary\docs\import_spec_overrides.csv;

  %if %sysfunc(fileexist(&_ovr_path)) %then %do;
    %put NOTE: [03_import] import_spec_overrides.csv found -- applying overrides;

    options errors=1;
    data work.spec_ovr;
      length file_code $4 col_order 8 src_name $256 orig_col_name $256
             sas_name $32 sas_type $1 length_ 8 informat $16 format $16 notes $200
             src_encoding $10;
      infile "&_ovr_path"
             encoding='utf-8' dsd dlm=',' missover firstobs=2 lrecl=32767;
      input file_code $ col_order src_name $ orig_col_name $ sas_name $
            sas_type $ length_ informat $ format $ notes $ src_encoding $;
      file_code     = strip(file_code);
      src_name      = strip(src_name);
      orig_col_name = strip(orig_col_name);
      sas_name      = strip(sas_name);
      sas_type      = strip(sas_type);
      informat      = strip(informat);
      format        = strip(format);
      notes         = strip(notes);
      src_encoding  = strip(src_encoding);
      /* D-23: no silent fallback -- any blank will be caught by _assert_spec_encoding */
      rename length_ = spec_length;
    run;
    options errors=20;

    /* For each override row, replace the matching spec_gen row.
       Log each override applied. */
    %local _n_ovr _io _fc _co _sn;
    proc sql noprint;
      select count(*) into :_n_ovr trimmed from work.spec_ovr;
    quit;

    %do _io = 1 %to &_n_ovr;
      data _null_;
        set work.spec_ovr(firstobs=&_io obs=&_io);
        call symputx('_ofc', strip(file_code), 'L');
        call symputx('_oco', strip(put(col_order, 8.)), 'L');
        call symputx('_osn', strip(sas_name), 'L');
      run;
      %put NOTE: [03_import] override applied: &_ofc col_order=&_oco sas_name=&_osn;
    %end;

    /* Merge: override rows replace matching gen rows by (file_code, col_order) */
    proc sort data=work.spec_gen; by file_code col_order; run;
    proc sort data=work.spec_ovr; by file_code col_order; run;

    data work.spec_gen;
      merge work.spec_gen(in=_g) work.spec_ovr(in=_o);
      by file_code col_order;
      /* override wins on all non-key columns -- merge already overwrites */
      if _g or _o;
    run;
  %end;
  %else %do;
    %put NOTE: [03_import] import_spec_overrides.csv not found -- using generated spec as-is;
  %end;
%mend _apply_overrides;
%_apply_overrides;

/* Join full_path and ftype from work.file_list */
proc sql;
  create table work.spec as
  select s.*, f.full_path, f.ftype
  from work.spec_gen s
  left join work.file_list f on upcase(s.file_code) = upcase(f.s_code)
  order by s.file_code, s.col_order;
quit;

%put NOTE: [03_import] work.spec built (merged spec + file paths);


/* ============================================================
   SECTION 5 -- CSV import code generation (pure DATA step)
   Reads work.spec sorted by file_code, col_order; buffers
   column info per file; emits one explicit DATA step per file.
   No macro logic inside PUT strings. All type branching uses
   DATA-step if/then/else on spec columns.
   16 CSV files: s01-s05, s07, s09-s10, s12-s18, s20.
   s18 -> work.src_s18_raw (exclusion step in Section 6).
   ============================================================ */

%let _n_csv_spec = -1;
%let _n_csv = -1;
proc sql noprint;
  select count(*) into :_n_csv_spec trimmed from work.spec where ftype = 'csv';
  select count(distinct file_code) into :_n_csv trimmed from work.spec where ftype = 'csv';
quit;
%macro _guard_csv_count;
  %if &_n_csv_spec = -1 or &_n_csv = -1 %then
    %fail_out(msg=%str(CSV spec count not populated));
  %if &_n_csv_spec = 0 %then
    %fail_out(msg=%str(no CSV rows in work.spec -- check spec load and file_list));
%mend _guard_csv_count;
%_guard_csv_count;
%put NOTE: [03_import] CSV spec rows: &_n_csv_spec across &_n_csv files;

proc sort data=work.spec(where=(ftype='csv')) out=work._spec_csv;
  by file_code col_order;
run;

filename _gen "&logs_path.\03_generated_import.sas" encoding='utf-8';

/* Overwrite any prior generated file with a header comment */
data _null_;
  file _gen lrecl=32767;
  put '/* Generated by 03_import.sas -- do not edit manually */';
run;

/* Generate one DATA step per CSV file; emit all sections at last.file_code.
   Arrays buffer column metadata; type branching is DATA-step if/then/else.
   src_encoding (D-23) is buffered per file and written to the INFILE option
   so wlatin1 files are transcoded to UTF-8 by SAS on read. */
%let _gen_chk_fail = 0;
data _null_;
  array _sn  {2000} $32  _sn1-_sn2000;   /* sas_name */
  array _st  {2000} $1   _st1-_st2000;   /* sas_type */
  array _sl  {2000}      _sl1-_sl2000;   /* spec_length */
  array _si  {2000} $40  _si1-_si2000;   /* informat */
  array _so  {2000} $256 _so1-_so2000;   /* orig_col_name */
  length _target $50 _fpath $500 _enc $10;
  retain _sn1-_sn2000 ' ' _st1-_st2000 ' ' _sl1-_sl2000 0
         _si1-_si2000 ' ' _so1-_so2000 ' '
         _nc 0 _target _fpath _enc ' ';
  retain _chk_fail 0;
  length line $2000;

  set work._spec_csv end=_last;
  by file_code;
  file _gen lrecl=32767 mod;

  if first.file_code then do;
    _nc = 0;
    /* s18 staged in work; pdd.src_s18 created in Section 6 after dup exclusion */
    if strip(file_code) = 's18' then _target = 'work.src_s18_raw';
    else _target = cats('pdd.src_', strip(file_code));
    _fpath = strip(full_path);
    /* D-23: use per-file encoding from spec (wlatin1 for 7 files, utf-8 for rest).
       No fallback: blank src_encoding means _assert_spec_encoding did not fire (impossible). */
    _enc = strip(src_encoding);
  end;

  _nc + 1;
  if _nc > 2000 then do;
    put 'ERROR: [03_import generated] column buffer overflow at ' file_code col_order;
    stop;
  end;
  _sn{_nc} = strip(sas_name);
  _st{_nc} = strip(sas_type);
  _sl{_nc} = spec_length;
  _si{_nc} = strip(informat);
  _so{_nc} = strip(orig_col_name);

  if last.file_code then do;
    /* DATA + INFILE -- single quotes around path: & and % do not expand */
    line = catx(' ', 'data', strip(_target)) || ';';
    if not prxmatch('/^data (pdd\.src_s\d\d|work\.src_s18_raw);$/', strip(line)) then do;
      put 'ERROR: [03_import gen] unexpected DATA line: ' line;
      _chk_fail + 1;
    end;
    put line;
    put '  options errors=1;';
    /* D-23: encoding= from src_encoding column; wlatin1 files get wlatin1 here */
    line = cats("  infile '", strip(_fpath),
                "' encoding='", strip(_enc),
                "' dlm=',' dsd truncover firstobs=2 lrecl=32767;");
    put line;

    /* LENGTH statement */
    put '  length';
    do _j = 1 to _nc;
      line = '    ' || catx(' ', strip(_sn{_j}),
               ifc(_st{_j} = 'C',
                   cats('$', strip(put(_sl{_j}, best8.))),
                   strip(put(_sl{_j}, best8.))));
      if not prxmatch('/^\S+ \$?\d+$/', strip(line)) then do;
        put 'ERROR: [03_import gen] unexpected LENGTH entry: ' line;
        _chk_fail + 1;
      end;
      put line;
    end;
    put '  ;';

    /* LABEL statement -- single quotes: & and % in column headers do not expand */
    put '  label';
    do _j = 1 to _nc;
      line = '    ' || catx(' ', strip(_sn{_j}), '=', quote(strip(_so{_j}), "'"));
      put line;
    end;
    put '  ;';

    /* INPUT statement */
    put '  input';
    do _j = 1 to _nc;
      if _st{_j} = 'C' then
        line = cats('    ', _sn{_j}, ' :$', strip(put(_sl{_j}, best8.)), '.');
      else if strip(_si{_j}) not in ('', 'best32.') then
        line = cats('    ', _sn{_j}, ' :', _si{_j});
      else
        line = cats('    ', _sn{_j}, ' :best32.');
      put line;
    end;
    put '  ;';

    /* Strip character fields to remove CSV padding */
    do _j = 1 to _nc;
      if _st{_j} = 'C' then do;
        line = cats('  ', _sn{_j}, ' = strip(', _sn{_j}, ');');
        put line;
      end;
    end;

    put 'run;';
    put 'options errors=20;';
    put ' ';
  end;
  if _last then call symputx('_gen_chk_fail', _chk_fail, 'L');
  drop _j;
run;

proc datasets lib=work nolist nowarn; delete _spec_csv; quit;

/* Validate: generated file must have at least (spec_rows + 5 * n_files) lines */
%let _gen_lines = -1;
data _null_;
  infile _gen end=_eof;
  input;
  retain _cnt 0;
  _cnt + 1;
  if _eof then call symputx('_gen_lines', _cnt, 'L');
run;
%macro _guard_gen_lines;
  %if &_gen_lines = -1 %then
    %fail_out(msg=%str(generated file line count not populated -- generation may have failed silently));
  %let _gen_min = %eval(&_n_csv_spec + 5 * &_n_csv);
  %if &_gen_lines < &_gen_min %then
    %fail_out(msg=%str(generated file has &_gen_lines lines, minimum expected &_gen_min));
  %put NOTE: [03_import] 03_generated_import.sas: &_gen_lines lines written (min expected &_gen_min);
%mend _guard_gen_lines;
%_guard_gen_lines;
%macro _guard_gen_syntax;
  %if &_gen_chk_fail > 0 %then
    %fail_out(msg=%str(generator emitted &_gen_chk_fail malformed line(s) -- see ERROR above));
  %put NOTE: [03_import] generator syntax check passed (0 malformed lines);
%mend _guard_gen_syntax;
%_guard_gen_syntax;

/* Execute the generated CSV DATA steps */
%put NOTE: [timing] csv_include start %sysfunc(datetime(), datetime20.);
options errors=1;
%include _gen;
options errors=20;
%put NOTE: [timing] csv_include end %sysfunc(datetime(), datetime20.);

%put NOTE: [03_import] %include of generated CSV steps complete;

/* Post-include asserts: 15 direct-to-pdd CSV datasets (s18 goes to work first) */
%macro _assert_csv_imports;
  %local _ifc _fc _n_fail _nobs _inv;
  %let _n_fail = 0;
  %let _csv_direct = s01 s02 s03 s04 s05 s07 s09 s10 s12 s13 s14 s15 s16 s17 s20;

  %do _ifc = 1 %to 15;
    %let _fc = %scan(&_csv_direct, &_ifc, %str( ));
    %if not %sysfunc(exist(pdd.src_&_fc)) %then %do;
      %put ERROR: [03_import] pdd.src_&_fc NOT found after %include;
      %let _n_fail = %eval(&_n_fail + 1);
    %end;
    %else %do;
      %let _nobs = -1;
      %let _inv  = -1;
      proc sql noprint;
        select count(*) into :_nobs trimmed from pdd.src_&_fc;
        select coalesce(row_count, -1) into :_inv trimmed
        from pdd.source_inventory where s_code = "&_fc";
      quit;
      %if &_nobs = -1 %then %do;
        %put ERROR: [03_import] pdd.src_&_fc nobs not populated;
        %let _n_fail = %eval(&_n_fail + 1);
      %end;
      %else %if &_nobs = 0 %then %do;
        %put ERROR: [03_import] pdd.src_&_fc has 0 rows;
        %let _n_fail = %eval(&_n_fail + 1);
      %end;
      %else %if &_inv = -1 %then
        %put NOTE: [03_import] pdd.src_&_fc = &_nobs rows (no inventory row -- cannot compare);
      %else %if &_nobs ne &_inv %then %do;
        %put ERROR: [03_import] pdd.src_&_fc = &_nobs rows, inventory = &_inv -- MISMATCH;
        %let _n_fail = %eval(&_n_fail + 1);
      %end;
      %else %put NOTE: [03_import] pdd.src_&_fc = &_nobs rows (matches inventory &_inv);
    %end;
  %end;
  %if &_n_fail > 0 %then
    %fail_out(msg=%str(&_n_fail CSV post-include assertion(s) failed -- see ERRORs above));
  %put NOTE: [03_import] all 15 direct-CSV pdd.src_s* assertions passed;
%mend _assert_csv_imports;
%_assert_csv_imports;


/* ============================================================
   SECTION 6 -- File-specific rules: s18 exclusion, s17 enc_for_linkage
   ============================================================ */

/* --- S18: exclude 2 dup/blank rows (char-cast both sides) --- */
/* Log the offending IDs from pdd.qc_s18_dup */
%macro _log_s18_dups;
  %local _nd _id;
  proc sql noprint;
    select count(*) into :_nd trimmed from pdd.qc_s18_dup;
  quit;
  %put NOTE: [03_import] s18 exclusion: pdd.qc_s18_dup has &_nd rows (expected 2);
  %local _i;
  %do _i = 1 %to &_nd;
    data _null_;
      set pdd.qc_s18_dup(firstobs=&_i obs=&_i);
      _id_char = strip(put(PRECEDE_STUDY_ID, best32.));
      call symputx('_dup_id', _id_char, 'L');
    run;
    %put NOTE: [03_import] s18 dup row &_i PRECEDE_STUDY_ID (as char) = &_dup_id;
  %end;
%mend _log_s18_dups;
%_log_s18_dups;

/* Create pdd.src_s18: all rows from work.src_s18_raw except those in pdd.qc_s18_dup */
/* pdd.qc_s18_dup.PRECEDE_STUDY_ID is NUMERIC; cast to char on both sides */
proc sql;
  create table pdd.src_s18 as
  select a.*
  from work.src_s18_raw a
  where not missing(a.PRECEDE_STUDY_ID)
    and strip(a.PRECEDE_STUDY_ID) ne ''
    and strip(a.PRECEDE_STUDY_ID) not in
      (select strip(put(d.PRECEDE_STUDY_ID, best32.))
       from pdd.qc_s18_dup d
       where not missing(d.PRECEDE_STUDY_ID));
quit;

%_note_written_ds(ds=pdd.src_s18, label=pdd.src_s18);

/* Assert pdd.qc_s18_dup unchanged (still 2 rows -- READ ONLY) */
%macro _assert_s18_dup_unchanged;
  %local _nd_after;
  proc sql noprint;
    select count(*) into :_nd_after trimmed from pdd.qc_s18_dup;
  quit;
  %if &_nd_after = 2 %then
    %put NOTE: [03_import] pdd.qc_s18_dup unchanged (&_nd_after rows) -- OK;
  %else
    %put WARNING: [03_import] pdd.qc_s18_dup row count = &_nd_after expected 2 -- REVIEW;
%mend _assert_s18_dup_unchanged;
%_assert_s18_dup_unchanged;


/* --- S17: derive enc_for_linkage from runtime ENCRYPTED_ENCOUNTER ambiguity (PDD-D-20) --- */

/* Apply %pdd_norm_psid to src_s17 to get norm_psid for grouping */
%pdd_norm_psid(in=pdd.src_s17, out=work._s17n, idvar=PRECEDE_STUDY_ID);

/* Derive the 6 ambiguous ENCRYPTED_ENCOUNTER tokens at runtime */
proc sql noprint;
  create table work._s17_ambig as
  select ENCRYPTED_ENCOUNTER
  from work._s17n
  where not missing(ENCRYPTED_ENCOUNTER)
    and strip(ENCRYPTED_ENCOUNTER) ne ''
  group by ENCRYPTED_ENCOUNTER
  having count(distinct norm_psid) > 1
  order by ENCRYPTED_ENCOUNTER;

  select count(*) into :_nambig trimmed from work._s17_ambig;
quit;

%put NOTE: [03_import] s17 ambiguous ENCRYPTED_ENCOUNTER count=&_nambig (PDD-D-20 expected 6);

%macro _check_s17_d20_early;
  %if &_nambig ne 6 %then
    %put WARNING: [03_import] s17 ambiguous ENCRYPTED_ENCOUNTER count=&_nambig expected 6 (PDD-D-20) -- review before Phase 5;
  %else
    %put NOTE: [03_import] s17 ambiguous ENCRYPTED_ENCOUNTER count=6 confirmed (PDD-D-20);
%mend _check_s17_d20_early;
%_check_s17_d20_early;

/* Load ambiguous tokens into global macro vars _ambig1 .. _ambig&_nambig */
data _null_;
  set work._s17_ambig;
  call symputx(cats('_ambig', _n_), strip(ENCRYPTED_ENCOUNTER), 'G');
run;

/* Build quoted list for IN() clause */
%macro _build_ambig_list;
  %local _ia _alist;
  %let _alist = ;
  %do _ia = 1 %to &_nambig;
    %if &_ia = 1 %then %let _alist = "&&_ambig&_ia";
    %else %let _alist = &_alist, "&&_ambig&_ia";
  %end;
  %global _ambig_quoted_list;
  %let _ambig_quoted_list = &_alist;
%mend _build_ambig_list;
%_build_ambig_list;

%put NOTE: [03_import] s17 ambig quoted list built (&_nambig tokens);

/* Rebuild pdd.src_s17 with enc_for_linkage column added (PDD-D-20).
   Use work intermediate to avoid in-place rewrite. */
%macro _blank_ambig;
  %if &_nambig > 0 %then %do;
    if enc_for_linkage in (&_ambig_quoted_list) then enc_for_linkage = '';
  %end;
%mend _blank_ambig;

/* D-24 note: ENCRYPTED_ENCOUNTER is used here as a linkage key (join key), NOT as a
   PCNR_ variable. D-24 sets status=LINKAGE_ONLY for ENCRYPTED_MRN and ENCRYPTED_ENCOUNTER
   in pdd.name_map (Phase 4), reducing PCNR variable count from 1299 to 1297.
   This Phase 3 linkage logic (D-19) is unaffected by D-24. */
data work._s17_enc;
  set pdd.src_s17;
  length enc_for_linkage $64;
  enc_for_linkage = ENCRYPTED_ENCOUNTER;
  %_blank_ambig;
  label enc_for_linkage = 'ENCRYPTED_ENCOUNTER blanked for ambiguous linkage (PDD-D-20)';
  /* Raw ENCRYPTED_ENCOUNTER stays unchanged */
run;

/* Replace pdd.src_s17 via proc datasets rename trick:
   write to work then move to pdd */
data pdd.src_s17;
  set work._s17_enc;
run;

proc datasets lib=work nolist nowarn; delete _s17_enc _s17n _s17_ambig; quit;

%_note_written_ds(ds=pdd.src_s17, label=pdd.src_s17);
%put NOTE: [03_import] s17 enc_for_linkage added (6 ambiguous tokens blanked);


/* ============================================================
   SECTION 7 -- XLSX imports: s06, s08, s11, s19
   Uses LIBNAME XLSX + spec-driven RENAME= + forced-char recast.
   Sheet names discovered at runtime via dictionary.members (XLSX libref).
   ============================================================ */

/* Initialise pdd.import_cache (created if absent). */
%_init_import_cache;

/* Compute code and spec hashes once; used by all _xlsx_cache_hit/_update calls. */
%_compute_cache_hashes;

/* Save and set validvarname=any so XLSX name literals work for columns
   with spaces / special chars; restore at end of section. */
%let _vvn_save = %sysfunc(getoption(validvarname));
options validvarname=any;

/* Helper macro: get the data sheet name for a given s_code.
   Assigns a temporary XLSX libref, queries dictionary.members for data sheets,
   clears the libref, and returns the first sheet name alphabetically.
   All 4 XLSX files (s06/s08/s11/s19) are single-data-sheet files. */

%macro _get_sheet_name(scode=, outmv=);
  %let &outmv = ;
  %local _sn _fpath _librc _n_sn;
  %let _sn = ;

  /* Get file path for this s_code */
  proc sql noprint;
    select distinct full_path into :_fpath trimmed
    from work.file_list
    where s_code = "&scode";
  quit;

  /* Assign XLSX libref to discover sheet names; clear before returning */
  libname _xlsnt xlsx "&_fpath";
  %let _librc = %sysfunc(libref(_xlsnt));
  %if &_librc ne 0 %then
    %fail_out(msg=%str(_get_sheet_name -- LIBNAME XLSX failed for &scode -- &_fpath));
  %else %do;
    proc sql noprint;
      select count(*) into :_n_sn trimmed
      from dictionary.members
      where upcase(libname) = '_XLSNT' and upcase(memtype) = 'DATA';
      select memname into :_xlsnt_sh1-:_xlsnt_sh999
      from dictionary.members
      where upcase(libname) = '_XLSNT' and upcase(memtype) = 'DATA'
      order by memname;
    quit;
    libname _xlsnt clear;
    %if &_n_sn ne 1 %then
      %fail_out(msg=%str(_get_sheet_name -- expected exactly 1 data sheet for &scode but found &_n_sn in &_fpath));
    %else %do;
      %let _sn = &&_xlsnt_sh1;
      %put NOTE: [03_import] &scode sheet name from dictionary.members: &_sn (&_n_sn sheet found);
    %end;
  %end;

  %let &outmv = &_sn;
%mend _get_sheet_name;


/* ---- Generator macro: one XLSX file -> generated .sas -> %include ---- */
/* Reads work.spec for fc; emits a DATA step .sas file; runs pre-include  */
/* syntax check; %include; checks &syserr.                                */
/* No macro code touches spec column text (src_name, orig_col_name).      */
/* sheet_mv: name of the macro var holding the sheet name (not its value) */
%macro _gen_xlsx_import(fc=, target=, sheet_mv=);
  %local _fc_path _sheet _gfile _chkfail_xl _ncols_xl _ncols_dc _nmatch_fail;
  %let _sheet = &&&sheet_mv;

  proc sql noprint;
    select distinct full_path into :_fc_path trimmed
    from work.file_list where s_code = "&fc";
    select count(*) into :_ncols_xl trimmed
    from work.spec where file_code = "&fc";
  quit;

  %if &_ncols_xl = 0 %then
    %fail_out(msg=%str(no spec rows for &fc in work.spec));

  %put NOTE: [03_import] XLSX gen &fc -- &_ncols_xl cols -- sheet=&_sheet -> &target;

  /* Pre-flight: open XLSX, get engine column names and positions via dictionary.columns */
  libname _xlimr xlsx "&_fc_path";
  %if %sysfunc(libref(_xlimr)) ne 0 %then
    %fail_out(msg=%str(_gen_xlsx_import -- LIBNAME XLSX failed for &fc: &_fc_path));

  proc sql noprint;
    select count(*) into :_ncols_dc trimmed
    from dictionary.columns
    where upcase(libname) = '_XLIMR'
      and upcase(memname) = upcase("&_sheet");

    create table work._xl_dc_&fc as
    select varnum, strip(name) as eng_name length=256,
           strip(type) as eng_type length=4,
           strip(format) as eng_format length=40
    from dictionary.columns
    where upcase(libname) = '_XLIMR'
      and upcase(memname) = upcase("&_sheet")
    order by varnum;
  quit;
  libname _xlimr clear;

  /* Fail if spec column count != engine column count */
  %if &_ncols_dc ne &_ncols_xl %then
    %fail_out(msg=%str(_gen_xlsx_import &fc -- spec has &_ncols_xl cols but XLSX engine has &_ncols_dc -- counts must match for positional import));

  /* Join spec to engine columns by col_order=varnum; flag unmatched positions */
  proc sql noprint;
    create table work._xl_spec_&fc as
    select s.col_order, s.sas_name, s.sas_type, s.spec_length,
           s.orig_col_name, s.format as spec_format length=40,
           d.eng_name, d.eng_type, d.eng_format,
           (d.varnum is null) as no_match
    from work.spec(where=(file_code="&fc")) s
    left join work._xl_dc_&fc d on s.col_order = d.varnum
    order by s.col_order;

    select count(*) into :_nmatch_fail trimmed
    from work._xl_spec_&fc where no_match = 1;
  quit;

  %if &_nmatch_fail > 0 %then
    %fail_out(msg=%str(_gen_xlsx_import &fc -- &_nmatch_fail spec col_order(s) have no matching XLSX varnum -- check spec col_order vs actual column count));

  %let _gfile = &logs_path.\03_generated_xlsx_&fc..sas;
  filename _xl_gen "&_gfile" encoding='utf-8';

  /* Write header comment, then append generated DATA step code */
  data _null_;
    file _xl_gen lrecl=32767;
    put "/* Generated by 03_import.sas for &fc -- do not edit */";
  run;

  %let _chkfail_xl = 0;
  data _null_;
    /* Column metadata arrays -- 4500 slots covers s06 (~3987 cols) */
    array _sn  {4500} $32   _sn1-_sn4500;   /* sas_name (target) */
    array _st  {4500} $1    _st1-_st4500;   /* sas_type from spec (C/N = target type) */
    array _sl  {4500}       _sl1-_sl4500;   /* spec_length */
    array _so  {4500} $256  _so1-_so4500;   /* orig_col_name (label) */
    array _en  {4500} $256  _en1-_en4500;   /* eng_name (actual XLSX header from engine) */
    array _et  {4500} $4    _et1-_et4500;   /* eng_type: char or num */
    array _ef  {4500} $40   _ef1-_ef4500;   /* eng_format (source format for date recast) */
    retain _sn1-_sn4500 ' ' _st1-_st4500 ' ' _sl1-_sl4500 0
           _so1-_so4500 ' ' _en1-_en4500 ' ' _et1-_et4500 ' ' _ef1-_ef4500 ' '
           _nc 0 _chkfail 0;
    length line $32000 qsrc $1000 tmp $8;

    set work._xl_spec_&fc end=_eof;
    file _xl_gen lrecl=32767 mod;

    _nc + 1;
    if _nc > 4500 then do;
      put 'ERROR: [03_import gen] column buffer overflow at col_order=' col_order;
      _chkfail + 1;
    end;
    _sn{_nc} = strip(sas_name);
    _st{_nc} = strip(sas_type);
    _sl{_nc} = spec_length;
    _so{_nc} = strip(orig_col_name);
    _en{_nc} = strip(eng_name);
    _et{_nc} = strip(eng_type);
    _ef{_nc} = strip(eng_format);

    if _eof then do;

      /* LIBNAME XLSX -- single quotes block macro expansion */
      line = "libname _xlimr xlsx '" || strip("&_fc_path") || "';";
      put line;

      /* DATA work._xl_raw_ -- check and emit */
      line = 'data work._xl_raw_;';
      if not prxmatch('/^data \S+;$/', strip(line)) then do;
        put 'ERROR: [03_import gen] unexpected DATA line for ' "&fc" ': ' line;
        _chkfail + 1;
      end;
      put line;

      /* SET with single-quoted name literal for sheet; RENAME by position:
         engine name (single-quoted if needed) -> sas_name */
      put "  set _xlimr.'" "&_sheet" "'n";
      put '    (rename=(';
      do _j = 1 to _nc;
        /* Always single-quoted name literal for RENAME source */
        qsrc = quote(strip(_en{_j}), "'") || 'n';
        line = '      ' || strip(qsrc) || '=' || strip(_sn{_j});
        put line;
      end;
      put '    ));';

      /* Buffer overflow guard */
      if _nc > 4500 then do;
        put 'ERROR: [03_import gen] column count exceeds 4500 buffer -- abort';
        _chkfail + 1;
      end;

      /* LENGTH for positional C-recast temp vars (named _c0001, _c0002, ...) */
      do _j = 1 to _nc;
        if _st{_j} = 'C' then do;
          tmp = cats('_c', put(_j, z4.));
          line = '  length ' || strip(tmp) || ' $' ||
                 strip(put(_sl{_j}, best8.)) || ';';
          if _nc > 4500 then do;
            put 'ERROR: [03_import gen] nc > 4500 in LENGTH loop';
            _chkfail + 1;
          end;
          put line;
        end;
      end;

      /* C-recast by SOURCE type (eng_type):
           numeric with date/time/datetime format -> strip(put(x, <eng_format>))
           other numeric                          -> strip(put(x, best32.))
           character source                       -> plain assignment */
      do _j = 1 to _nc;
        if _st{_j} = 'C' then do;
          tmp = cats('_c', put(_j, z4.));
          _is_dt = (upcase(strip(_ef{_j})) =: 'DATE'     or
                    upcase(strip(_ef{_j})) =: 'DATETIME'  or
                    upcase(strip(_ef{_j})) =: 'TIME'      or
                    upcase(strip(_ef{_j})) =: 'MMDDYY'    or
                    upcase(strip(_ef{_j})) =: 'DDMMYY'    or
                    upcase(strip(_ef{_j})) =: 'YYMMDD'    or
                    upcase(strip(_ef{_j})) =: 'MONYY');
          if _et{_j} = 'num' and _is_dt and strip(_ef{_j}) ne '' then
            line = '  ' || strip(tmp) || ' = strip(put(' || strip(_sn{_j}) ||
                   ', ' || strip(_ef{_j}) || '));';
          else if _et{_j} = 'num' then
            line = '  ' || strip(tmp) || ' = strip(put(' || strip(_sn{_j}) || ', best32.));';
          else
            line = '  ' || strip(tmp) || ' = ' || strip(_sn{_j}) || ';';
          put line;
          line = '  drop ' || strip(_sn{_j}) || ';';
          put line;
          line = '  rename ' || strip(tmp) || ' = ' || strip(_sn{_j}) || ';';
          put line;
        end;
      end;

      put 'run;';

      /* Move to target and apply labels */
      line = cats("data &target;");
      if not prxmatch('/^data \S+;$/', strip(line)) then do;
        put 'ERROR: [03_import gen] unexpected target DATA line for ' "&fc" ': ' line;
        _chkfail + 1;
      end;
      put line;
      put '  set work._xl_raw_;';
      put '  label';
      do _j = 1 to _nc;
        line = '    ' || strip(_sn{_j}) || ' = ' || quote(strip(_so{_j}), "'");
        put line;
      end;
      put '  ;';
      put 'run;';

      put 'libname _xlimr clear;';
      put "proc datasets lib=work nolist nowarn; delete _xl_raw_; quit;";

      call symputx('_chkfail_xl', _chkfail, 'L');
    end;
    drop _j _is_dt;
  run;

  %if &_chkfail_xl > 0 %then
    %fail_out(msg=%str(XLSX generator for &fc emitted &_chkfail_xl malformed line(s)));
  %else
    %put NOTE: [03_import] &fc generator syntax check passed;

  %let _cc0 = &syscc;
  options errors=1;
  %include _xl_gen;
  options errors=20;
  %if &syscc > %sysfunc(max(&_cc0, 4)) %then
    %fail_out(msg=%str(XLSX generated include for &fc failed -- syscc=&syscc));
  %else %if not %sysfunc(exist(&target)) %then
    %fail_out(msg=%str(XLSX generated include for &fc -- target &target does not exist after include));
  %else %do;
    %local _xl_nobs;
    %let _xl_nobs = -1;
    proc sql noprint;
      select count(*) into :_xl_nobs trimmed from &target;
    quit;
    %if &_xl_nobs = 0 %then
      %fail_out(msg=%str(XLSX generated include for &fc -- target &target has 0 rows after include));
  %end;
  filename _xl_gen clear;
  %put NOTE: [03_import] &fc XLSX import complete via generated code;
%mend _gen_xlsx_import;


