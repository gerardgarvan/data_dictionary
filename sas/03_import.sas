/* ============================================================
   SECTION 9 -- s06 column-group profile
   pdd.qc_s06_groups + qc\s06_column_groups.xlsx
   ============================================================ */

/* Build the column-group table from pdd.header_inventory where s_code='s06'
   plus non-null % from pdd.src_s06. */

/* Step 9a: get s06 column inventory with inferred type from header_inventory */
proc sql;
  create table work._s06_cols as
  select col_name, col_type, col_len
  from pdd.header_inventory
  where s_code = 's06'
  order by col_name;
quit;

/* Step 9b: compute % non-null per column from pdd.src_s06
   For large column counts (3987) use dictionary.columns + a summary approach.
   We compute n non-missing via PROC MEANS ALL variables then join. */

/* Get total row count of pdd.src_s06 */
proc sql noprint;
  select count(*) into :_ns06 trimmed from pdd.src_s06;
quit;
%put NOTE: [03_import] pdd.src_s06 row count = &_ns06;

/* Use PROC FREQ / MEANS is impractical for 3987 cols.
   Instead compute nmiss per column via PROC MEANS and derive pct_nonnull. */
proc means data=pdd.src_s06 nmiss noprint;
  output out=work._s06_nmiss(drop=_type_ _freq_) nmiss= / autoname;
run;

/* The output is 1 row wide with one var per column named <varname>_NMiss.
   Transpose to long form. */
proc transpose data=work._s06_nmiss out=work._s06_nmiss_long(rename=(col1=nmiss_val));
run;

data work._s06_nmiss_long;
  set work._s06_nmiss_long;
  /* _NAME_ = 'COLNAME_NMiss' -> strip suffix */
  col_name = substr(_NAME_, 1, length(_NAME_) - 6);  /* strip '_NMiss' */
  pct_nonnull = round(100 * (1 - nmiss_val / max(1, &_ns06)), 0.1);
  keep col_name pct_nonnull;
run;

/* Step 9c: assign group prefix heuristic (Pattern 6).
   prefix = chars before first '_' or first digit run; min 3 / max 20 chars.
   Cols with no shared prefix (or prefix < 3 chars) -> '_SINGLETON_'. */
data work._s06_cols2;
  set work._s06_cols;
  length group_prefix $20;

  _pos_us = index(col_name, '_');
  _pos_dg = prxmatch('/\d/', col_name);

  /* Find first delimiter: underscore or digit run, min 3 chars */
  if _pos_us >= 3 and (_pos_dg = 0 or _pos_us <= _pos_dg) then
    group_prefix = upcase(substr(col_name, 1, min(20, _pos_us - 1)));
  else if _pos_dg >= 3 and (_pos_us = 0 or _pos_dg < _pos_us) then
    group_prefix = upcase(substr(col_name, 1, min(20, _pos_dg - 1)));
  else if length(col_name) >= 3 then
    group_prefix = upcase(substr(col_name, 1, min(20, length(col_name))));
  else
    group_prefix = '_SINGLETON_';

  if length(strip(group_prefix)) < 3 then group_prefix = '_SINGLETON_';
  drop _pos_us _pos_dg;
run;

/* Step 9d: join non-null % */
proc sql;
  create table work._s06_cols3 as
  select c.col_name, c.col_type, c.group_prefix,
         coalesce(n.pct_nonnull, 0) as pct_nonnull
  from work._s06_cols2 c
  left join work._s06_nmiss_long n on upcase(c.col_name) = upcase(n.col_name);
quit;

/* Step 9e: compute overlap with s03/s07 columns */
proc sql;
  create table work._s03s07_cols as
  select distinct upcase(col_name) as col_name_up length=200
  from pdd.header_inventory
  where s_code in ('s03', 's07');
quit;

/* Step 9f: build pdd.qc_s06_groups -- one row per group */
proc sql;
  create table work._s06_grp_base as
  select c.group_prefix as group length=20,
         count(*) as col_count,
         /* Modal col_type */
         case when sum(case when c.col_type='char' then 1 else 0 end) > 0
                and sum(case when c.col_type='num'  then 1 else 0 end) > 0
              then 'mixed'
              when sum(case when c.col_type='char' then 1 else 0 end) > 0
              then 'char'
              else 'num'
         end as inferred_type length=5,
         median(c.pct_nonnull) as median_pct_nonnull,
         sum(case when upcase(c.col_name) in (select col_name_up from work._s03s07_cols)
                  then 1 else 0 end) as overlap_s03_s07
  from work._s06_cols3 c
  group by c.group_prefix
  order by col_count desc;
quit;

/* Build example_cols: first 3 col_names alphabetically per group */
proc sort data=work._s06_cols3; by group_prefix col_name; run;

data work._s06_examples;
  set work._s06_cols3;
  by group_prefix;
  retain _eg_cnt 0 _examples '';
  length _examples $200;
  if first.group_prefix then do;
    _eg_cnt = 0;
    _examples = '';
  end;
  _eg_cnt + 1;
  if _eg_cnt <= 3 then do;
    if _examples = '' then _examples = strip(col_name);
    else _examples = catx(', ', _examples, strip(col_name));
  end;
  if last.group_prefix then do;
    group = group_prefix;
    example_cols = _examples;
    output;
  end;
  keep group example_cols;
run;

proc sql;
  create table pdd.qc_s06_groups as
  select g.group, e.example_cols length=200, g.col_count, g.inferred_type,
         round(g.median_pct_nonnull, 0.1) as median_pct_nonnull,
         g.overlap_s03_s07
  from work._s06_grp_base g
  left join work._s06_examples e on g.group = e.group
  order by g.col_count desc;
quit;

%_note_written_ds(ds=pdd.qc_s06_groups, label=pdd.qc_s06_groups);

/* Assert sum(col_count) = s06 total column count */
%macro _assert_s06_groups;
  %local _sum_cols _tot_cols;
  proc sql noprint;
    select sum(col_count) into :_sum_cols trimmed from pdd.qc_s06_groups;
    select count(*) into :_tot_cols trimmed
    from pdd.header_inventory
    where s_code = 's06';
  quit;
  %put NOTE: [03_import] s06 group profile: sum(col_count)=&_sum_cols total_cols_in_inventory=&_tot_cols;
  %if &_sum_cols = &_tot_cols %then
    %put NOTE: [03_import] s06 group col_count sum matches inventory total -- OK;
  %else
    %put WARNING: [03_import] s06 group col_count sum=&_sum_cols ne inventory total=&_tot_cols -- review;
%mend _assert_s06_groups;
%_assert_s06_groups;

