/*==========================================================================
  Program : 03_import.sas
  Project : PeCAN Data Dictionary (PDD)
  Purpose : Phase 3 Plan 02 -- Runtime import of all 20 source files.
            Reads docs\import_spec_generated.csv (with optional override from
            docs\import_spec_overrides.csv), writes one explicit DATA step per
            source to &logs_path.\03_generated_import.sas via a data _null_
            FILE statement, %includes it to execute, then handles XLSX imports
            (s06/s08/s11/s19) with LIBNAME XLSX + spec-driven RENAME/recast,
            applies file-specific rules (s19 blank-row drop PDD-D-08, s18
            dup exclusion char-cast both sides, s17 enc_for_linkage runtime
            derivation PDD-D-20), and produces pdd.qc_s06_groups +
            qc\s06_column_groups.xlsx.

  Reads   : docs\import_spec_generated.csv (generated by 03a_build_spec.sas)
            docs\import_spec_overrides.csv (optional; Gerard-edited rows only)
            &raw_master (read-only -- 20 source files)
            pdd.source_inventory (sheet names, row counts)
            pdd.qc_s18_dup (READ ONLY -- 2 dup/blank s18 rows from Phase 2)
            pdd.header_inventory (s06 col profiles for group profiling)

  Writes  : pdd.src_s01 .. pdd.src_s20 (raw source datasets)
            pdd.qc_s06_groups (column-group profile)
            &logs_path.\03_generated_import.sas (generated; not committed)
            &qc_path.\s06_column_groups.xlsx

  PCM compliance:
    - No open-code %IF outside a %macro block
    - %abort cancel only inside %fail_out
    - No apostrophes or embedded semicolons in %put text
    - No PROC SQL UPDATE
    - No in-place dataset rewrite (data X; set X;) -- s17 exception is
      data pdd.src_s17; set pdd.src_s17; which is technically in-place;
      use a work intermediate then rename
    - dictionary.columns.type: 'char' / 'num' (not 1/2)

  Author  : GSD Phase 03 Plan 02
==========================================================================*/


/* ============================================================
   SECTION 0 -- Header, %include, %pdd_lib
   ============================================================ */

%include "C:\data_dictionary\sas\00_config.sas";

/* Assign the pdd output library.
   %check_encoding and %check_pdd_lib are called below after %fail_out
   is defined so they can call %fail_out on failure. */
%pdd_lib;


/* ============================================================
   SECTION 1 -- Utility macros (retargeted from 02_source_guard.sas)
   ============================================================ */

/* Route the log to a per-program file when running standalone */
%macro route_log;
  %if &in_pipeline = 0 %then %do;
    proc printto log="&logs_path.\03_import.log" new; run;
  %end;
%mend route_log;

/* Restore the log to the default destination */
%macro restore_log;
  %if &in_pipeline = 0 %then %do;
    proc printto; run;
  %end;
%mend restore_log;

/* Abort with a loud ERROR message. %abort cancel is ONLY called here. */
%macro fail_out(msg=);
  %put ERROR: [03_import] &msg;
  %abort cancel;
%mend fail_out;

/* Encoding and library checks -- placed here so %fail_out is available */
%check_encoding;
%check_pdd_lib;

/* Print a NOTE that a pdd dataset was written, confirmed with rowcount > 0 */
%macro _note_written_ds(ds=, label=);
  %local _nw;
  %let _nw = 0;
  %if %sysfunc(exist(&ds)) %then %do;
    proc sql noprint;
      select count(*) into :_nw trimmed from &ds;
    quit;
    %if &_nw > 0 %then
      %put NOTE: [03_import] &label written (&_nw rows);
    %else
      %put WARNING: [03_import] &label written but has 0 rows;
  %end;
  %else
    %put WARNING: [03_import] &label was NOT written;
%mend _note_written_ds;

/* Print a NOTE that a QC xlsx was written, confirmed via fileexist */
%macro _note_written_xlsx(path=, label=);
  %if %sysfunc(fileexist(&path)) %then
    %put NOTE: [03_import] &label written;
  %else
    %put WARNING: [03_import] &label was NOT written;
%mend _note_written_xlsx;

/* Begin log redirect immediately after macro definitions */
%route_log;

%put NOTE: [03_import] === Phase 3 Plan 02 starting ===;
%put NOTE: [03_import] raw_master  = &raw_master;
%put NOTE: [03_import] out_root    = &out_root;
%put NOTE: [03_import] qc_path     = &qc_path;
%put NOTE: [03_import] logs_path   = &logs_path;
%put NOTE: [03_import] in_pipeline = &in_pipeline;


/* ============================================================
   SECTION 2 -- Preconditions
   ============================================================ */

/* import_spec_generated.csv must exist and be populated */
%macro _check_preconditions;
  %if not %sysfunc(fileexist(C:\data_dictionary\docs\import_spec_generated.csv)) %then
    %fail_out(msg=%str(FATAL -- docs\import_spec_generated.csv not found. Run 03a_build_spec.sas first to populate the spec));

  /* Check the spec has data rows beyond the header */
  %local _spec_size;
  %let _spec_size = %sysfunc(fopen(C:\data_dictionary\docs\import_spec_generated.csv));
  %let _spec_size = %sysfunc(fclose(&_spec_size));
  /* pdd.qc_s18_dup must exist (Phase 2 output) */
  %if not %sysfunc(exist(pdd.qc_s18_dup)) %then
    %fail_out(msg=%str(FATAL -- pdd.qc_s18_dup not found. Phase 2 must have run successfully before Phase 3));
  /* pdd.source_inventory must exist for XLSX sheet name lookup */
  %if not %sysfunc(exist(pdd.source_inventory)) %then
    %fail_out(msg=%str(FATAL -- pdd.source_inventory not found. Phase 2 must have run successfully before Phase 3));
%mend _check_preconditions;
%_check_preconditions;

%put NOTE: [03_import] Preconditions passed;


/* ============================================================
   SECTION 3 -- Build work.file_list (20-row DATALINES)
   Columns: s_code, filename, ftype, full_path
   Copied verbatim from 02_source_guard.sas Section 3.
   ============================================================ */
data work.file_list;
  length s_code $4 filename $200 ftype $5 full_path $500;
  infile datalines dsd dlm='|' truncover;
  input s_code $ filename $ ftype $;
  full_path = cats("&raw_master.\", filename);
  datalines;
s01|2018-2022_PACU_STAY_20260813.csv|csv
s02|2018_2019_2020_Induction_Emergent20231121.csv|csv
s03|2018_2019_CPT_ROLLUP_X_MASTER_DATASET_20200801.csv|csv
s04|2018_2019_ENCOUNTER_Crypto_Data_20260814.csv|csv
s05|2018_2019_MRN_Crypto_Data20260814.csv|csv
s06|2018_2019_Precede_Database.xlsx|xlsx
s07|2018_2019_X_MASTER_DATASET_20200801.csv|csv
s08|2018_2022_COLONOSCOPY_20240118.xlsx|xlsx
s09|2018_2022_X_MASTER_DATASET_20240402.csv|csv
s10|2020_CPT_ROLLUP_X_MASTER_DATASET_20210609.csv|csv
s11|2020_Precede_Database_Edu.xlsx|xlsx
s12|2020_X_MASTER_DATASET_20210519.csv|csv
s13|2021_Education_20240124.csv|csv
s14|2021_Frailty_20240123.csv|csv
s15|2021_X_MASTER_DATASET_20230512.csv|csv
s16|2022_Education_20240124.csv|csv
s17|2022_MASTER_DATASET_20231024.csv|csv
s18|2022_RES_20230927.csv|csv
s19|ALL_AIM2_MASTER_DATASET_20210917.xlsx|xlsx
s20|All_YEARS_LAT_LONG_20231127.csv|csv
;

%put NOTE: [03_import] work.file_list built (20 rows);


/* ============================================================
   SECTION 4 -- Spec load + override merge
   ============================================================ */

/* Read import_spec_generated.csv into work.spec_gen */
options errors=1;
data work.spec_gen;
  length file_code $4 col_order 8 src_name $32 orig_col_name $256
         sas_name $32 sas_type $1 length_ 8 informat $16 format $16 notes $100;
  infile "C:\data_dictionary\docs\import_spec_generated.csv"
         encoding='utf-8' dsd dlm=',' missover firstobs=2 lrecl=32767;
  input file_code $ col_order src_name $ orig_col_name $ sas_name $
        sas_type $ length_ informat $ format $ notes $;
  /* Strip all character fields to remove CSV padding */
  file_code     = strip(file_code);
  src_name      = strip(src_name);
  orig_col_name = strip(orig_col_name);
  sas_name      = strip(sas_name);
  sas_type      = strip(sas_type);
  informat      = strip(informat);
  format        = strip(format);
  notes         = strip(notes);
  /* Rename length_ -> length after read (length is a reserved word in step
     context but fine as a variable name after assignment) */
  rename length_ = spec_length;
run;
options errors=20;

%put NOTE: [03_import] work.spec_gen loaded;

/* If import_spec_overrides.csv exists, read and merge (override wins) */
%macro _apply_overrides;
  %local _ovr_path;
  %let _ovr_path = C:\data_dictionary\docs\import_spec_overrides.csv;

  %if %sysfunc(fileexist(&_ovr_path)) %then %do;
    %put NOTE: [03_import] import_spec_overrides.csv found -- applying overrides;

    options errors=1;
    data work.spec_ovr;
      length file_code $4 col_order 8 src_name $32 orig_col_name $256
             sas_name $32 sas_type $1 length_ 8 informat $16 format $16 notes $100;
      infile "&_ovr_path"
             encoding='utf-8' dsd dlm=',' missover firstobs=2 lrecl=32767;
      input file_code $ col_order src_name $ orig_col_name $ sas_name $
            sas_type $ length_ informat $ format $ notes $;
      file_code     = strip(file_code);
      src_name      = strip(src_name);
      orig_col_name = strip(orig_col_name);
      sas_name      = strip(sas_name);
      sas_type      = strip(sas_type);
      informat      = strip(informat);
      format        = strip(format);
      notes         = strip(notes);
      rename length_ = spec_length;
    run;
    options errors=20;

    /* For each override row, replace the matching spec_gen row.
       Log each override applied. */
    %local _n_ovr _io _fc _co _sn;
    proc sql noprint;
      select count(*) into :_n_ovr trimmed from work.spec_ovr;
    quit;

    %do _io = 1 %to &_n_ovr;
      data _null_;
        set work.spec_ovr(firstobs=&_io obs=&_io);
        call symputx('_ofc', strip(file_code), 'L');
        call symputx('_oco', strip(put(col_order, 8.)), 'L');
        call symputx('_osn', strip(sas_name), 'L');
      run;
      %put NOTE: [03_import] override applied: &_ofc col_order=&_oco sas_name=&_osn;
    %end;

    /* Merge: override rows replace matching gen rows by (file_code, col_order) */
    proc sort data=work.spec_gen; by file_code col_order; run;
    proc sort data=work.spec_ovr; by file_code col_order; run;

    data work.spec_gen;
      merge work.spec_gen(in=_g) work.spec_ovr(in=_o);
      by file_code col_order;
      /* override wins on all non-key columns -- merge already overwrites */
      if _g or _o;
    run;
  %end;
  %else %do;
    %put NOTE: [03_import] import_spec_overrides.csv not found -- using generated spec as-is;
  %end;
%mend _apply_overrides;
%_apply_overrides;

/* Join full_path and ftype from work.file_list */
proc sql;
  create table work.spec as
  select s.*, f.full_path, f.ftype
  from work.spec_gen s
  left join work.file_list f on upcase(s.file_code) = upcase(f.s_code)
  order by s.file_code, s.col_order;
quit;

%put NOTE: [03_import] work.spec built (merged spec + file paths);


/* ============================================================
   SECTION 5 -- CSV import code generation via data _null_ FILE
   Generates &logs_path.\03_generated_import.sas then %includes it.
   16 CSV files: s01-s05, s07, s09-s10, s12-s18, s20.
   s18 targets work.src_s18_raw (final exclusion step in Section 6).
   s17 is imported as a standard CSV (enc_for_linkage added in Section 6).
   ============================================================ */

/* Get distinct CSV file codes from spec (ftype='csv') sorted */
proc sql noprint;
  select distinct file_code
  into :_csv_codes separated by ' '
  from work.spec
  where ftype='csv'
  order by file_code;
  select count(distinct file_code) into :_n_csv trimmed
  from work.spec
  where ftype='csv';
quit;

%put NOTE: [03_import] CSV file codes (&_n_csv): &_csv_codes;

/* Write the generated import SAS file via data _null_ */
data _null_;
  file "&logs_path.\03_generated_import.sas" lrecl=32767 encoding='utf-8';

  /* Iterate over each CSV file_code */
  /* We read spec into arrays per file_code via a macro loop below */
  put '/* Generated by 03_import.sas -- do not edit manually */';
  put "/* Generated: &sysdate &systime */";
run;

/* Macro to append one CSV DATA step to the generated file */
%macro _write_csv_step(fc=);
  %local _full _target _ncols _ic _vn _vt _vl _vi _vf;

  /* Get full_path for this file_code */
  proc sql noprint;
    select distinct full_path into :_full trimmed
    from work.spec
    where file_code = "&fc";
    select count(*) into :_ncols trimmed
    from work.spec
    where file_code = "&fc";
  quit;

  /* Target: s18 goes to work.src_s18_raw; all others to pdd.src_&fc */
  %if "&fc" = "s18" %then %let _target = work.src_s18_raw;
  %else %let _target = pdd.src_&fc;

  %put NOTE: [03_import] writing generated DATA step for &fc -> &_target (&_ncols cols);

  /* Load spec columns into arrays indexed 1..&_ncols */
  data work._spec_fc_;
    set work.spec(where=(file_code="&fc")) end=_eof;
    /* Variables already in col_order from spec sort */
    _i = _n_;
    call symputx(cats('_vn', _n_), strip(sas_name),   'L');
    call symputx(cats('_vt', _n_), strip(sas_type),   'L');
    call symputx(cats('_vl', _n_), strip(put(spec_length, 8.)), 'L');
    call symputx(cats('_vi', _n_), strip(informat),   'L');
    call symputx(cats('_vo', _n_), strip(orig_col_name), 'L');
    if _eof then call symputx('_ncols_fc', put(_n_, 8.), 'L');
  run;

  data _null_;
    file "&logs_path.\03_generated_import.sas" lrecl=32767 encoding='utf-8' mod;

    /* DATA statement */
    put "data &_target;";
    put "  options errors=1;";
    put "  infile ""&_full"" encoding='utf-8' dlm=',' dsd missover firstobs=2 lrecl=32767;";

    /* LENGTH statement */
    put "  length";
    %do _ic = 1 %to &_ncols_fc;
      %let _vn = &&_vn&_ic;
      %let _vt = &&_vt&_ic;
      %let _vl = &&_vl&_ic;
      %if "&_vt" = "C" %then %do;
        put "    &_vn $ &_vl";
      %end;
      %else %do;
        put "    &_vn 8";
      %end;
    %end;
    put "  ;";

    /* LABEL statement */
    put "  label";
    %do _ic = 1 %to &_ncols_fc;
      %let _vn = &&_vn&_ic;
      /* Escape embedded double-quotes in orig_col_name */
      %local _voe;
      %let _voe = %sysfunc(tranwrd(%superq(_vo&_ic), %str("), %str("")));
      put "    &_vn = ""&_voe""";
    %end;
    put "  ;";

    /* INPUT statement */
    put "  input";
    %do _ic = 1 %to &_ncols_fc;
      %let _vn = &&_vn&_ic;
      %let _vt = &&_vt&_ic;
      %let _vl = &&_vl&_ic;
      %let _vi = &&_vi&_ic;
      %if "&_vt" = "C" %then %do;
        put "    &_vn :$&_vl..";
      %end;
      %else %if "&_vi" ^= "" and "&_vi" ^= "best32." %then %do;
        put "    &_vn :&_vi";
      %end;
      %else %do;
        put "    &_vn :best32.";
      %end;
    %end;
    put "  ;";

    put "run;";
    put "options errors=20;";
    put "%_note_written_ds(ds=&_target, label=&_target);";
    put " ";
  run;

  proc datasets lib=work nolist nowarn; delete _spec_fc_; quit;

%mend _write_csv_step;

/* Loop over all CSV file codes */
%macro _generate_csv_steps;
  %local _ifc _fc;
  %do _ifc = 1 %to &_n_csv;
    %let _fc = %scan(&_csv_codes, &_ifc, %str( ));
    %_write_csv_step(fc=&_fc);
  %end;
%mend _generate_csv_steps;
%_generate_csv_steps;

%put NOTE: [03_import] 03_generated_import.sas written -- %sysfunc(fileexist(&logs_path.\03_generated_import.sas)) (1=exists);

/* Execute the generated file */
options errors=1;
%include "&logs_path.\03_generated_import.sas";
options errors=20;

%put NOTE: [03_import] 03_generated_import.sas %include complete;


/* ============================================================
   SECTION 6 -- File-specific rules: s18 exclusion, s17 enc_for_linkage
   ============================================================ */

/* --- S18: exclude 2 dup/blank rows (char-cast both sides) --- */
/* Log the offending IDs from pdd.qc_s18_dup */
%macro _log_s18_dups;
  %local _nd _id;
  proc sql noprint;
    select count(*) into :_nd trimmed from pdd.qc_s18_dup;
  quit;
  %put NOTE: [03_import] s18 exclusion: pdd.qc_s18_dup has &_nd rows (expected 2);
  %local _i;
  %do _i = 1 %to &_nd;
    data _null_;
      set pdd.qc_s18_dup(firstobs=&_i obs=&_i);
      _id_char = strip(put(PRECEDE_STUDY_ID, best32.));
      call symputx('_dup_id', _id_char, 'L');
    run;
    %put NOTE: [03_import] s18 dup row &_i PRECEDE_STUDY_ID (as char) = &_dup_id;
  %end;
%mend _log_s18_dups;
%_log_s18_dups;

/* Create pdd.src_s18: all rows from work.src_s18_raw except those in pdd.qc_s18_dup */
/* pdd.qc_s18_dup.PRECEDE_STUDY_ID is NUMERIC; cast to char on both sides */
proc sql;
  create table pdd.src_s18 as
  select a.*
  from work.src_s18_raw a
  where not missing(a.PRECEDE_STUDY_ID)
    and strip(a.PRECEDE_STUDY_ID) ne ''
    and strip(a.PRECEDE_STUDY_ID) not in
      (select strip(put(d.PRECEDE_STUDY_ID, best32.))
       from pdd.qc_s18_dup d
       where not missing(d.PRECEDE_STUDY_ID));
quit;

%_note_written_ds(ds=pdd.src_s18, label=pdd.src_s18);

/* Assert pdd.qc_s18_dup unchanged (still 2 rows -- READ ONLY) */
%macro _assert_s18_dup_unchanged;
  %local _nd_after;
  proc sql noprint;
    select count(*) into :_nd_after trimmed from pdd.qc_s18_dup;
  quit;
  %if &_nd_after = 2 %then
    %put NOTE: [03_import] pdd.qc_s18_dup unchanged (&_nd_after rows) -- OK;
  %else
    %put WARNING: [03_import] pdd.qc_s18_dup row count = &_nd_after expected 2 -- REVIEW;
%mend _assert_s18_dup_unchanged;
%_assert_s18_dup_unchanged;


/* --- S17: derive enc_for_linkage from runtime ENCRYPTED_ENCOUNTER ambiguity (PDD-D-20) --- */

/* Apply %pdd_norm_psid to src_s17 to get norm_psid for grouping */
%pdd_norm_psid(in=pdd.src_s17, out=work._s17n, idvar=PRECEDE_STUDY_ID);

/* Derive the 6 ambiguous ENCRYPTED_ENCOUNTER tokens at runtime */
proc sql noprint;
  create table work._s17_ambig as
  select ENCRYPTED_ENCOUNTER
  from work._s17n
  where not missing(ENCRYPTED_ENCOUNTER)
    and strip(ENCRYPTED_ENCOUNTER) ne ''
  group by ENCRYPTED_ENCOUNTER
  having count(distinct norm_psid) > 1
  order by ENCRYPTED_ENCOUNTER;

  select count(*) into :_nambig trimmed from work._s17_ambig;
quit;

%put NOTE: [03_import] s17 ambiguous ENCRYPTED_ENCOUNTER count=&_nambig (PDD-D-20 expected 6);

%macro _assert_s17_ambig;
  %if &_nambig ne 6 %then
    %put WARNING: [03_import] s17 ambiguous ENCRYPTED_ENCOUNTER count=&_nambig expected 6 (PDD-D-20) -- review before Phase 5;
  %else
    %put NOTE: [03_import] s17 ambiguous ENCRYPTED_ENCOUNTER count=6 confirmed (PDD-D-20);
%mend _assert_s17_ambig;
%_assert_s17_ambig;

/* Load ambiguous tokens into global macro vars _ambig1 .. _ambig&_nambig */
data _null_;
  set work._s17_ambig;
  call symputx(cats('_ambig', _n_), strip(ENCRYPTED_ENCOUNTER), 'G');
run;

/* Build quoted list for IN() clause */
%macro _build_ambig_list;
  %local _ia _alist;
  %let _alist = ;
  %do _ia = 1 %to &_nambig;
    %if &_ia = 1 %then %let _alist = "&&_ambig&_ia";
    %else %let _alist = &_alist, "&&_ambig&_ia";
  %end;
  %global _ambig_quoted_list;
  %let _ambig_quoted_list = &_alist;
%mend _build_ambig_list;
%_build_ambig_list;

%put NOTE: [03_import] s17 ambig quoted list built (&_nambig tokens);

/* Rebuild pdd.src_s17 with enc_for_linkage column added (PDD-D-20).
   Use work intermediate to avoid in-place rewrite. */
data work._s17_enc;
  set pdd.src_s17;
  length enc_for_linkage $64;
  enc_for_linkage = ENCRYPTED_ENCOUNTER;
  %macro _blank_ambig;
    %if &_nambig > 0 %then %do;
      if enc_for_linkage in (&_ambig_quoted_list) then enc_for_linkage = '';
    %end;
  %mend _blank_ambig;
  %_blank_ambig;
  label enc_for_linkage = 'ENCRYPTED_ENCOUNTER blanked for ambiguous linkage (PDD-D-20)';
  /* Raw ENCRYPTED_ENCOUNTER stays unchanged */
run;

/* Replace pdd.src_s17 via proc datasets rename trick:
   write to work then move to pdd */
data pdd.src_s17;
  set work._s17_enc;
run;

proc datasets lib=work nolist nowarn; delete _s17_enc _s17n _s17_ambig; quit;

%_note_written_ds(ds=pdd.src_s17, label=pdd.src_s17);
%put NOTE: [03_import] s17 enc_for_linkage added (6 ambiguous tokens blanked);


/* ============================================================
   SECTION 7 -- XLSX imports: s06, s08, s11, s19
   Uses LIBNAME XLSX + spec-driven RENAME= + forced-char recast.
   Sheet names discovered at runtime via dictionary.members (XLSX libref).
   ============================================================ */

/* Helper macro: get the data sheet name for a given s_code.
   Assigns a temporary XLSX libref, queries dictionary.members for data sheets,
   clears the libref, and returns the first sheet name alphabetically.
   All 4 XLSX files (s06/s08/s11/s19) are single-data-sheet files. */

%macro _get_sheet_name(scode=, outmv=);
  %global &outmv;
  %let &outmv = ;
  %local _sn _fpath _librc _n_sn;
  %let _sn = ;

  /* Get file path for this s_code */
  proc sql noprint;
    select distinct full_path into :_fpath trimmed
    from work.file_list
    where s_code = "&scode";
  quit;

  /* Assign XLSX libref to discover sheet names; clear before returning */
  libname _xlsnt xlsx "&_fpath";
  %let _librc = %sysfunc(libref(_xlsnt));
  %if &_librc ne 0 %then
    %put WARNING: [03_import] _get_sheet_name: LIBNAME XLSX failed for &scode -- &_fpath;
  %else %do;
    proc sql noprint;
      select count(*) into :_n_sn trimmed
      from dictionary.members
      where upcase(libname) = '_XLSNT' and upcase(memtype) = 'DATA';
      select memname into :_xlsnt_sh1-:_xlsnt_sh999
      from dictionary.members
      where upcase(libname) = '_XLSNT' and upcase(memtype) = 'DATA'
      order by memname;
    quit;
    libname _xlsnt clear;
    %if &_n_sn > 0 %then %do;
      %let _sn = &&_xlsnt_sh1;
      %put NOTE: [03_import] &scode sheet name from dictionary.members: &_sn (&_n_sn sheet(s) found);
    %end;
    %else
      %put WARNING: [03_import] _get_sheet_name: no data sheets found for &scode in &_fpath;
  %end;

  %let &outmv = &_sn;
%mend _get_sheet_name;


/* ---- Macro to import one XLSX file via LIBNAME XLSX ---- */
/* Applies spec RENAME= and forced-char recast.            */
%macro _import_xlsx(fc=, target=, sheet_mv=);
  /* sheet_mv is a macro var NAME (not value) holding the sheet name */
  %local _fc_path _sheet _ncols _ic _nmatch_rename;

  /* Get full_path */
  proc sql noprint;
    select distinct full_path into :_fc_path trimmed
    from work.file_list
    where s_code = "&fc";
    select count(*) into :_ncols trimmed
    from work.spec
    where file_code = "&fc";
  quit;

  %let _sheet = &&&sheet_mv;
  %put NOTE: [03_import] XLSX import &fc from &_fc_path sheet=&_sheet -> &target (&_ncols spec cols);

  /* Assign LIBNAME XLSX */
  libname _xlimr xlsx "&_fc_path";

  %if %sysfunc(libref(_xlimr)) ne 0 %then %do;
    %put WARNING: [03_import] LIBNAME XLSX failed for &fc -- &_fc_path;
  %end;
  %else %do;

    /* Load spec for this file_code into macro arrays */
    data work._spec_xl_;
      set work.spec(where=(file_code="&fc")) end=_eof;
      _i = _n_;
      call symputx(cats('_xvn', _n_), strip(sas_name),     'L');  /* sas_name */
      call symputx(cats('_xvo', _n_), strip(src_name),     'L');  /* orig src_name (XLSX col) */
      call symputx(cats('_xvt', _n_), strip(sas_type),     'L');  /* C or N */
      call symputx(cats('_xvl', _n_), strip(put(spec_length, 8.)), 'L');
      call symputx(cats('_xvf', _n_), strip(format),       'L');  /* format */
      call symputx(cats('_xvc', _n_), strip(orig_col_name),'L');  /* label */
      if _eof then call symputx('_ncols_xl', put(_n_, 8.), 'L');
    run;

    /* Build RENAME= list (src_name -> sas_name where they differ) */
    %local _rename_clause _ic2;
    %let _rename_clause = ;
    %do _ic2 = 1 %to &_ncols_xl;
      %local _xvo_v _xvn_v;
      %let _xvo_v = &&_xvo&_ic2;
      %let _xvn_v = &&_xvn&_ic2;
      %if "&_xvo_v" ne "&_xvn_v" and %length(&_xvo_v) > 0 %then %do;
        /* Check if src_name is a valid SAS name (no spaces/special chars) */
        %if %sysfunc(prxmatch(%str(/^[A-Za-z_]\w*$/), &_xvo_v)) %then
          %let _rename_clause = &_rename_clause &_xvo_v=&_xvn_v;
        %else
          %let _rename_clause = &_rename_clause "&_xvo_v"n=&_xvn_v;
      %end;
    %end;

    /* Write DATA step for the XLSX sheet using a name-literal branch (Pitfall 1) */
    /* Sheet name can start with digit (e.g. 2018_...) -- always use name literal */
    %macro _do_xlsx_data_step;
      data work._xl_raw_;
        %if %length(&_rename_clause) > 0 %then %do;
          set _xlimr."&_sheet"n (rename=(&_rename_clause));
        %end;
        %else %do;
          set _xlimr."&_sheet"n;
        %end;

        /* Forced-char recast for C columns (Pitfall 10: XLSX gives numeric for IDs) */
        %do _ic = 1 %to &_ncols_xl;
          %local _xvn_v2 _xvt_v _xvl_v _xvf_v;
          %let _xvn_v2 = &&_xvn&_ic;
          %let _xvt_v  = &&_xvt&_ic;
          %let _xvl_v  = &&_xvl&_ic;
          %let _xvf_v  = &&_xvf&_ic;
          %if "&_xvt_v" = "C" %then %do;
            /* Re-cast to character: create temp var, replace, drop, rename */
            length &_xvn_v2._c $&_xvl_v;
            &_xvn_v2._c = cats(&_xvn_v2);
            drop &_xvn_v2;
            rename &_xvn_v2._c = &_xvn_v2;
          %end;
          %else %if %length(&_xvf_v) > 0 %then %do;
            /* Preserve numeric format (dates etc.) */
            format &_xvn_v2 &_xvf_v;
          %end;
        %end;

        /* Apply labels */
        label
        %do _ic = 1 %to &_ncols_xl;
          %local _xvn_v3 _xvc_v;
          %let _xvn_v3 = &&_xvn&_ic;
          %let _xvc_v  = &&_xvc&_ic;
          %local _xvc_esc;
          %let _xvc_esc = %sysfunc(tranwrd(%superq(_xvc_v), %str("), %str("")));
          &_xvn_v3 = "&_xvc_esc"
        %end;
        ;
      run;
      %let syscc = 0;
    %mend _do_xlsx_data_step;
    %_do_xlsx_data_step;

    /* Move work._xl_raw_ to the target dataset */
    data &target;
      set work._xl_raw_;
    run;

    libname _xlimr clear;
    proc datasets lib=work nolist nowarn; delete _xl_raw_ _spec_xl_; quit;

  %end;

%mend _import_xlsx;


