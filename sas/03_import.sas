  %if &_nqc = 20 %then
    %put NOTE: [03_import] qc_import_rowcounts has 20 rows -- OK;
  %else
    %put WARNING: [03_import] qc_import_rowcounts has &_nqc rows expected 20 -- review;
%mend _assert_qc_20;
%_assert_qc_20;


