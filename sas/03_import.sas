/* ============================================================
   SECTION 12 -- norm_psid loop (dictionary.tables-driven)
   Build the dataset list from dictionary.tables where
   libname='PDD' and memname like 'SRC_S__' (exact 2-digit suffix).
   Look up idvar from pdd.key_analysis per dataset.
   Fail if any blank dataset name; never emit data ; set ;.
   ============================================================ */

%macro _check_key_analysis;
  %if not %sysfunc(exist(pdd.key_analysis)) %then
    %fail_out(msg=%str(FATAL -- pdd.key_analysis not found. Phase 2 must have run before Phase 3));
%mend _check_key_analysis;
%_check_key_analysis;

%macro _norm_psid_loop;
  %local _nds _ids _dsname _fc _idvar _n_applied _skipped_list _has_np;
  %let _nds = -1;
  %let _n_applied = 0;
  %let _skipped_list = ;

  /* Build list of actual pdd.src_sNN datasets from dictionary (two-digit suffix only) */
  proc sql noprint;
    select count(*) into :_nds trimmed
    from dictionary.tables
    where upcase(libname) = 'PDD'
      and memname like 'SRC_S__';
    select memname into :_ds1-:_ds100
    from dictionary.tables
    where upcase(libname) = 'PDD'
      and memname like 'SRC_S__'
    order by memname;
  quit;
  %if &_nds = -1 %then %fail_out(msg=%str(_norm_psid_loop count not populated));
  %put NOTE: [03_import] norm_psid loop: &_nds pdd.src_s* datasets found;

  %do _ids = 1 %to &_nds;
    %let _dsname = &&_ds&_ids;
    %if %length(%superq(_dsname)) = 0 %then
      %fail_out(msg=%str(_norm_psid_loop -- blank dataset name at index &_ids));

    /* Derive s_code: SRC_S01 -> s01 */
    %let _fc = %lowcase(%substr(&_dsname, 5));

    /* Use only the PRECEDE_STUDY_ID key row; ignore ENCRYPTED_* rows */
    %let _idvar = ;
    proc sql noprint;
      select strip(key_var_name) into :_idvar trimmed
      from pdd.key_analysis
      where strip(s_code) = "&_fc"
        and upcase(strip(key_column_type)) = 'PRECEDE_STUDY_ID';
    quit;

    %if %length(%superq(_idvar)) = 0 %then %do;
      /* Spine and linkage files must have a Study ID key — fail if s09 or s17 */
      %if "&_fc" = "s09" or "&_fc" = "s17" %then
        %fail_out(msg=%str(_norm_psid_loop -- &_fc has no PRECEDE_STUDY_ID key row in pdd.key_analysis (expected for spine/linkage file)));
      %let _skipped_list = &_skipped_list &_fc;
    %end;
    %else %do;
      /* Skip if norm_psid already present (XLSX cache reuse -- must not append twice) */
      %let _has_np = 0;
      proc sql noprint;
        select count(*) into :_has_np trimmed
        from dictionary.columns
        where upcase(libname) = 'PDD'
          and upcase(memname) = upcase("&_dsname")
          and upcase(name) = 'NORM_PSID';
      quit;
      %if &_has_np > 0 %then
        %put NOTE: [03_import] norm_psid already on pdd.&_dsname (cache reuse) -- skipping;
      %else %do;
        %put NOTE: [03_import] applying pdd_norm_psid to pdd.&_dsname idvar=&_idvar (PRECEDE_STUDY_ID);
        %pdd_norm_psid(in=pdd.&_dsname, out=pdd.&_dsname, idvar=&_idvar);
        %let _n_applied = %eval(&_n_applied + 1);
      %end;
    %end;
  %end;

  /* Report all skipped files in one NOTE; expected: s04 s05 (crypto linkage, PDD-D-18) */
  %if %length(%superq(_skipped_list)) > 0 %then
    %put NOTE: [03_import] norm_psid skipped (no PRECEDE_STUDY_ID key row): &_skipped_list;
  %put NOTE: [03_import] norm_psid applied to &_n_applied of &_nds src_s* datasets;

  /* Spot check: norm_psid on pdd.src_s01 */
  %local _ncol_s01;
  %let _ncol_s01 = -1;
  proc sql noprint;
    select count(*) into :_ncol_s01 trimmed
    from dictionary.columns
    where upcase(libname) = 'PDD' and upcase(memname) = 'SRC_S01'
      and upcase(name) = 'NORM_PSID';
  quit;
  %if &_ncol_s01 = -1 %then
    %fail_out(msg=%str(norm_psid spot-check count not populated));
  %if &_ncol_s01 ne 1 %then
    %fail_out(msg=%str(norm_psid NOT found on pdd.src_s01 -- check key_analysis and pdd_norm_psid macro));
  %put NOTE: [03_import] norm_psid confirmed on pdd.src_s01;

%mend _norm_psid_loop;
%_norm_psid_loop;

/* Assert: every keyed pdd.src_s* (has PRECEDE_STUDY_ID row in key_analysis) has exactly
   one norm_psid column.  Catches double-application on cache reuse or missed application. */
%macro _assert_norm_psid_cols;
  %local _nk _ifc _fc _nc_np _n_fail;
  %let _nk = -1;
  %let _n_fail = 0;
  proc sql noprint;
    select count(distinct s_code) into :_nk trimmed
    from pdd.key_analysis
    where upcase(strip(key_column_type)) = 'PRECEDE_STUDY_ID';
    select distinct s_code into :_kfc1-:_kfc100
    from pdd.key_analysis
    where upcase(strip(key_column_type)) = 'PRECEDE_STUDY_ID'
    order by s_code;
  quit;
  %if &_nk = -1 %then %fail_out(msg=%str(_assert_norm_psid_cols -- keyed count not populated));
  %do _ifc = 1 %to &_nk;
    %let _fc = &&_kfc&_ifc;
    %let _nc_np = 0;
    proc sql noprint;
      select count(*) into :_nc_np trimmed
      from dictionary.columns
      where upcase(libname) = 'PDD'
        and upcase(memname) = upcase("SRC_&_fc")
        and upcase(name) = 'NORM_PSID';
    quit;
    %if &_nc_np ne 1 %then %do;
      %put ERROR: [03_import] pdd.src_&_fc has &_nc_np norm_psid column(s) expected exactly 1;
      %let _n_fail = %eval(&_n_fail + 1);
    %end;
    %else %put NOTE: [03_import] pdd.src_&_fc norm_psid confirmed (1 column);
  %end;
  %if &_n_fail > 0 %then
    %fail_out(msg=%str(&_n_fail keyed pdd.src_s* dataset(s) do not have exactly 1 norm_psid column));
  %put NOTE: [03_import] norm_psid column assert passed -- all &_nk keyed datasets have exactly 1 norm_psid;
%mend _assert_norm_psid_cols;
%_assert_norm_psid_cols;

/* Sanity assert: >99% of non-blank norm_psid in s09 and s17 must match Precede##### */
%macro _assert_psid_fmt(fc=);
  %local _n_total _n_match _pct_int;
  %let _n_total = 0;
  %let _n_match = 0;
  proc sql noprint;
    select count(*) into :_n_total trimmed
    from pdd.src_&fc
    where not missing(norm_psid) and strip(norm_psid) ne '';
    select count(*) into :_n_match trimmed
    from pdd.src_&fc
    where prxmatch('/^Precede\d{5}$/', strip(norm_psid));
  quit;
  %put NOTE: [03_import] &fc norm_psid format check: match=&_n_match total=&_n_total;
  %if &_n_total = 0 %then
    %fail_out(msg=%str(norm_psid sanity assert &fc -- no non-blank norm_psid values found));
  /* Integer percent: multiply by 100 then divide; fail if < 99 */
  %let _pct_int = %sysfunc(floor(%sysevalf(&_n_match * 100 / &_n_total)));
  %if &_pct_int < 99 %then
    %fail_out(msg=%str(norm_psid sanity assert &fc -- only &_n_match of &_n_total match Precede##### (&_pct_int pct) expected >99 pct));
  %put NOTE: [03_import] norm_psid sanity assert PASS -- &fc &_n_match/&_n_total match Precede##### (&_pct_int pct);
%mend _assert_psid_fmt;
%_assert_psid_fmt(fc=s09);
%_assert_psid_fmt(fc=s17);


/* ============================================================
   SECTION 13 -- D-19 assert: s17/s09 encounter join
   PDD-D-19: n_pairs locked after first passing run; ndis=0 locked.
   TODO: lock the exact n_pairs value after the first live run passes
   (03 excludes ambiguous encounters differently from Phase 2; do not
   hard-code 9001 until confirmed here).
   Join pdd.src_s17 to pdd.src_s09 on ENCRYPTED_ENCOUNTER.
   Exclude ambiguous encounters on both sides (re-derived here
   because work._s17_ambig was deleted in Section 6 cleanup).
   ============================================================ */

/* Look up s09 encounter column from pdd.key_analysis or header_inventory.
   Phase 2 shows s09 has ENCRYPTED_ENCOUNTER; confirm via key_analysis.
   The key_column_type for s09 is PRECEDE_STUDY_ID; the encounter col may
   appear in header_inventory.  Use a safe fallback to ENCRYPTED_ENCOUNTER. */
%macro _get_s09_enc_col;
  %global _s09_enc_col;
  %let _s09_enc_col = ;

  /* Try header_inventory for the ENCRYPTED_ENCOUNTER column in s09 */
  proc sql noprint;
    select strip(col_name) into :_s09_enc_col trimmed
    from pdd.header_inventory
    where s_code = 's09'
      and upcase(col_name) = 'ENCRYPTED_ENCOUNTER'
    having count(*) > 0;
  quit;

  %if %length(%superq(_s09_enc_col)) = 0 %then %do;
    %let _s09_enc_col = ENCRYPTED_ENCOUNTER;
    %put NOTE: [03_import] s09 ENCRYPTED_ENCOUNTER not found in header_inventory -- using default: &_s09_enc_col;
  %end;
  %else
    %put NOTE: [03_import] s09 encounter column from header_inventory: &_s09_enc_col;
%mend _get_s09_enc_col;
%_get_s09_enc_col;

/* Re-derive ambiguous s17 ENCRYPTED_ENCOUNTER tokens.
   work._s17_ambig was deleted in Section 6 cleanup; re-derive from pdd.src_s17
   (norm_psid is now present after Section 12). */
proc sql noprint;
  create table work._s17_ambig_d19 as
  select ENCRYPTED_ENCOUNTER
  from pdd.src_s17
  where not missing(ENCRYPTED_ENCOUNTER)
    and strip(ENCRYPTED_ENCOUNTER) ne ''
  group by ENCRYPTED_ENCOUNTER
  having count(distinct norm_psid) > 1
  order by ENCRYPTED_ENCOUNTER;

  select count(*) into :_nambig_d19 trimmed from work._s17_ambig_d19;
quit;

%put NOTE: [03_import] D-19 pre-check: s17 ambiguous encounter count = &_nambig_d19 (expected 6);
/* PDD-D-20: fail if s17 ambiguous count deviates from the locked value of 6 */
%macro _assert_s17_ambig;
  %if &_nambig_d19 ne 6 %then
    %fail_out(msg=%str(PDD-D-19/D-20 assert failed -- s17 ambiguous ENCRYPTED_ENCOUNTER count=&_nambig_d19 expected 6));
  %put NOTE: [03_import] PDD-D-20 assert passed -- s17 ambiguous ENCRYPTED_ENCOUNTER count=6;
%mend _assert_s17_ambig;
%_assert_s17_ambig;

/* Derive ambiguous s09 ENCRYPTED_ENCOUNTER tokens (Phase 2 found 317; locked). */
proc sql noprint;
  create table work._s09_ambig_d19 as
  select &_s09_enc_col as ENCRYPTED_ENCOUNTER length=64
  from pdd.src_s09
  where not missing(&_s09_enc_col)
    and strip(&_s09_enc_col) ne ''
  group by &_s09_enc_col
  having count(distinct norm_psid) > 1
  order by &_s09_enc_col;

  select count(*) into :_nambig_s09_d19 trimmed from work._s09_ambig_d19;
quit;

%put NOTE: [03_import] D-19 pre-check: s09 ambiguous encounter count = &_nambig_s09_d19 (Phase 2 found 317);

/* Build the encounter-join check table.
   Exclude ambiguous encounters on both sides (s17: 6, s09: 317 per Phase 2).
   n_pairs locked to 9001 (Phase 2 02_source_guard _qc_normalisation_2022 log). */
proc sql;
  create table work._d19_check as
  select a.norm_psid as s17_norm length=64,
         b.norm_psid as s09_norm length=64
  from pdd.src_s17 a
    inner join pdd.src_s09 b
      on a.ENCRYPTED_ENCOUNTER = b.&_s09_enc_col
  where not missing(a.ENCRYPTED_ENCOUNTER)
    and not missing(b.&_s09_enc_col)
    and a.ENCRYPTED_ENCOUNTER not in
          (select ENCRYPTED_ENCOUNTER from work._s17_ambig_d19)
    and b.&_s09_enc_col not in
          (select ENCRYPTED_ENCOUNTER from work._s09_ambig_d19);
  select count(*) into :_d19_npairs trimmed from work._d19_check;
  select count(*) into :_d19_ndis   trimmed from work._d19_check
    where s17_norm ne s09_norm;
  select count(*) into :_d19_nblank trimmed from work._d19_check
    where missing(s17_norm) or strip(s17_norm) = ''
       or missing(s09_norm) or strip(s09_norm) = '';
quit;

%put NOTE: [03_import] D-19 check: n_pairs=&_d19_npairs ndis=&_d19_ndis nblank=&_d19_nblank;

%macro _assert_d19;
  /* Locked n_pairs = 9001 from Phase 2 02_source_guard _qc_normalisation_2022 */
  %if &_d19_npairs ne 9001 %then
    %fail_out(msg=%str(PDD-D-19 assert failed -- n_pairs=&_d19_npairs expected 9001 (Phase 2 locked value)));
  %if &_d19_ndis ne 0 %then
    %fail_out(msg=%str(PDD-D-19 assert failed -- s17/s09 norm_psid disagreements=&_d19_ndis expected 0));
  %if &_d19_nblank > 0 %then
    %fail_out(msg=%str(PDD-D-19 assert failed -- &_d19_nblank pair(s) have blank s17_norm or s09_norm));
  %put NOTE: [03_import] PDD-D-19 assert passed -- n_pairs=9001 ndis=0 nblank=0;
%mend _assert_d19;
%_assert_d19;

proc datasets lib=work nolist nowarn; delete _s17_ambig_d19 _s09_ambig_d19 _d19_check; quit;


/* ============================================================
   SECTION 14 -- QC row-count reconciliation vs pdd.source_inventory
   Builds pdd.qc_import_rowcounts (one row per file_code, 20 rows).
   Spot asserts: s01=41423, s08=3456.
   Status logic:
     s18 -- expected-diff (imported = inventory - 2, dup exclusion)
     s19 -- expected-diff (imported <= inventory, blank-row drop PDD-D-08)
     others -- match if imported = inventory; else MISMATCH
   ============================================================ */

/* Spot assert helper */
%macro _spot_assert(fc=, expected=);
  %local _sa_cnt;
  proc sql noprint;
    select count(*) into :_sa_cnt trimmed from pdd.src_&fc;
  quit;
  %if &_sa_cnt = &expected %then
    %put NOTE: [03_import] spot assert PASS -- pdd.src_&fc = &_sa_cnt (expected &expected);
  %else
    %fail_out(msg=%str(spot assert FAIL -- pdd.src_&fc = &_sa_cnt expected &expected));
%mend _spot_assert;
%_spot_assert(fc=s01, expected=41423);
%_spot_assert(fc=s08, expected=3456);

/* Build pdd.qc_import_rowcounts */
%macro _build_qc_rowcounts;
  %local _all_codes _ifc _fc _imp_rows _inv_rows _status _d19_exp_delta;
  %let _all_codes = s01 s02 s03 s04 s05 s06 s07 s08 s09 s10
                    s11 s12 s13 s14 s15 s16 s17 s18 s19 s20;

  /* Start fresh accumulator table in work */
  data work._qc_rc_accum;
    length file_code $4 imported_rows 8 inventory_rows 8
           expected_delta $40 status $20;
    stop;
  run;

  %do _ifc = 1 %to 20;
    %let _fc = %scan(&_all_codes, &_ifc, %str( ));

    /* Get imported row count */
    proc sql noprint;
      select count(*) into :_imp_rows trimmed from pdd.src_&_fc;
    quit;

    /* Get inventory row count */
    %let _inv_rows = .;
    proc sql noprint;
      select coalesce(row_count, .) into :_inv_rows trimmed
      from pdd.source_inventory
      where s_code = "&_fc"
      having count(*) > 0;
    quit;

    /* Fail-fast if either count is blank or missing (prevents bad %eval) */
    %if "&_imp_rows" = "" or "&_imp_rows" = "." %then
      %fail_out(msg=%str(qc_rowcounts &_fc -- imported row count is blank or missing));
    %if "&_inv_rows" = "" or "&_inv_rows" = "." %then
      %fail_out(msg=%str(qc_rowcounts &_fc -- no source_inventory row found -- all 20 s_codes must have an inventory entry));

    /* Determine expected_delta and status */
    %if "&_fc" = "s18" %then %do;
      %let _d19_exp_delta = s18 -2 dup excl;
      /* s18: imported should be inventory - 2 */
      %if "&_inv_rows" ne "." %then %do;
        %if &_imp_rows = %eval(&_inv_rows - 2) %then %let _status = expected-diff;
        %else %let _status = MISMATCH;
      %end;
      %else %let _status = no-inventory;
    %end;
    %else %if "&_fc" = "s19" %then %do;
      /* s19: match if no blank rows dropped; expected-diff only if rows were removed */
      %if "&_inv_rows" ne "." %then %do;
        %if &_imp_rows = &_inv_rows %then %do;
          %let _status = match;
          %let _d19_exp_delta = 0;
        %end;
        %else %if &_imp_rows < &_inv_rows %then %do;
          %let _status = expected-diff;
          %let _d19_exp_delta = s19 kept<source blank-drop;
        %end;
        %else %let _status = MISMATCH;
      %end;
      %else %let _status = no-inventory;
    %end;
    %else %do;
      %let _d19_exp_delta = 0;
      %if "&_inv_rows" ne "." %then %do;
        %if &_imp_rows = &_inv_rows %then %let _status = match;
        %else %let _status = MISMATCH;
      %end;
      %else %let _status = no-inventory;
    %end;

    %put NOTE: [03_import] qc_rowcounts &_fc imported=&_imp_rows inventory=&_inv_rows status=&_status;

    /* Append one row via PROC APPEND (no redundant SET accumulation) */
    data work._qc_rc_new;
      length file_code $4 imported_rows 8 inventory_rows 8
             expected_delta $40 status $20;
      file_code      = "&_fc";
      imported_rows  = &_imp_rows;
      inventory_rows = &_inv_rows;
      expected_delta = "&_d19_exp_delta";
      status         = "&_status";
      output;
    run;
    proc append base=work._qc_rc_accum data=work._qc_rc_new force; run;

  %end;

  /* Write final permanent dataset */
  data pdd.qc_import_rowcounts;
    set work._qc_rc_accum;
    label
      file_code      = 'Source file code (s01-s20)'
      imported_rows  = 'Row count in pdd.src_<fc>'
      inventory_rows = 'Row count from pdd.source_inventory'
      expected_delta = 'Expected difference explanation (0 = exact match expected)'
      status         = 'match / expected-diff / MISMATCH';
  run;

  proc datasets lib=work nolist nowarn; delete _qc_rc_accum _qc_rc_new; quit;

%mend _build_qc_rowcounts;
%_build_qc_rowcounts;

%_note_written_ds(ds=pdd.qc_import_rowcounts, label=pdd.qc_import_rowcounts);

/* Assert no MISMATCH rows */
%macro _assert_no_mismatch;
  %local _n_mm;
  proc sql noprint;
    select count(*) into :_n_mm trimmed
    from pdd.qc_import_rowcounts
    where status = 'MISMATCH';
  quit;
  %if &_n_mm > 0 %then
    %fail_out(msg=%str(row-count reconciliation MISMATCH -- see pdd.qc_import_rowcounts));
  %else
    %put NOTE: [03_import] qc_import_rowcounts: no MISMATCH rows -- all 20 files reconciled OK;
%mend _assert_no_mismatch;
%_assert_no_mismatch;

/* Assert total 20 rows */
%macro _assert_qc_20;
  %local _nqc;
  proc sql noprint;
    select count(*) into :_nqc trimmed from pdd.qc_import_rowcounts;
  quit;
  %if &_nqc = 20 %then
    %put NOTE: [03_import] qc_import_rowcounts has 20 rows -- OK;
  %else
    %fail_out(msg=%str(qc_import_rowcounts has &_nqc rows expected exactly 20 -- check _build_qc_rowcounts));
%mend _assert_qc_20;
%_assert_qc_20;


